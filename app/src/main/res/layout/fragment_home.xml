<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="homeFragment"
            type="com.sallyjayz.ranchid.home.HomeFragment" />

    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".home.HomeFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/home_fragment_constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/sixteen_dp"
            android:layout_marginEnd="@dimen/sixteen_dp"
            android:layout_marginBottom="@dimen/sixteen_dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/welcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/offline_tv"
                android:layout_marginTop="@dimen/sixteen_dp"
                android:fontFamily="@font/inter_regular"
                android:textSize="@dimen/sixteen_sp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Bukky"
                android:layout_marginStart="5dp"
                app:layout_constraintStart_toEndOf="@id/welcome"
                app:layout_constraintTop_toBottomOf="@id/offline_tv"
                android:layout_marginTop="@dimen/sixteen_dp"
                android:fontFamily="@font/inter_bold"
                android:textSize="@dimen/sixteen_sp"
                android:textColor="@color/black" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/error_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_regular"
                android:textAlignment="center"
                android:padding="@dimen/four_dp"
                android:text="@string/offline"
                android:visibility="invisible"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/offline_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/offline"
                android:drawableStart="@drawable/ic_warning"
                android:fontFamily="@font/inter_regular"
                android:background="@color/offline_background"
                android:textColor="@color/offline_text"
                android:padding="@dimen/four_dp"
                android:visibility="invisible"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/user_activities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/your_activities"
                android:textAllCaps="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/user_name"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/thirty_two_dp"
                android:fontFamily="@font/inter_bold"
                android:textSize="@dimen/sixteen_sp"
                android:textColor="@color/black"/>

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/home_tablayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:tabIndicator="@drawable/custom_tab_indicator"
                app:tabIndicatorColor="@color/nait_blue"
                app:tabIndicatorFullWidth="false"
                app:tabSelectedTextColor="@color/nait_blue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/user_activities"
                app:tabMode="fixed" />

            <androidx.viewpager2.widget.ViewPager2
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:id="@+id/home_pager"
                android:layout_marginBottom="@dimen/thirty_two_dp"
                app:layout_constraintStart_toStartOf="@id/home_tablayout"
                app:layout_constraintEnd_toEndOf="@id/home_tablayout"
                app:layout_constraintTop_toBottomOf="@id/home_tablayout"/>

