<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".offline.taglivestock.OfflineFragmentTagLivestock">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/error_tv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/offline"
                android:drawableStart="@drawable/ic_warning"
                android:fontFamily="@font/inter_regular"
                android:background="@color/offline_background"
                android:textColor="@color/offline_text"
                android:padding="@dimen/four_dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_margin="@dimen/ten_dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/offline_tag_livestock_recyclerview"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="@dimen/ten_dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/error_tv"/>

            <include
                android:id="@+id/empty_data_present"
                layout="@layout/item_empty_dataset"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_margin="@dimen/ten_dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/offline_tag_livestock_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:visibility="invisible"
                app:indicatorColor="@android:color/black"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>
</layout>