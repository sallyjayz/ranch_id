<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="offlineTagLivestockDetail"
            type="com.sallyjayz.ranchid.offline.taglivestock.OfflineTagLivestockDetailFragment" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".offline.taglivestock.OfflineTagLivestockDetailFragment">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/sixteen_dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/error_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_red_light"
                    app:layout_constraintBottom_toTopOf="@id/offline_livestock_detail_tagid"
                    app:layout_constraintStart_toStartOf="@id/offline_livestock_detail_tagid"
                    app:layout_constraintEnd_toEndOf="@id/offline_livestock_detail_tagid"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_livestock_detail_tagid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:text="@string/scanned_tag_id"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/offline_taglivestock_tagid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_livestock_detail_tagid"
                    app:layout_constraintEnd_toEndOf="@id/offline_livestock_detail_tagid"
                    app:layout_constraintTop_toBottomOf="@id/offline_livestock_detail_tagid"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tagid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_livestock_detail_passport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_taglivestock_tagid"
                    app:layout_constraintEnd_toEndOf="@id/offline_taglivestock_tagid"
                    app:layout_constraintTop_toBottomOf="@id/offline_taglivestock_tagid"
                    android:text="@string/passport_id"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_taglivestock_passport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_livestock_detail_passport"
                    app:layout_constraintEnd_toEndOf="@id/offline_livestock_detail_passport"
                    app:layout_constraintTop_toBottomOf="@id/offline_livestock_detail_passport"
                    tools:text="Passport Id"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <!--<com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_livestock_detail_keeper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_taglivestock_passport"
                    app:layout_constraintEnd_toEndOf="@id/offline_taglivestock_passport"
                    app:layout_constraintTop_toBottomOf="@id/offline_taglivestock_passport"
                    android:text="@string/livestock_keeper"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_taglivestock_keeper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_livestock_detail_keeper"
                    app:layout_constraintEnd_toEndOf="@id/offline_livestock_detail_keeper"
                    app:layout_constraintTop_toBottomOf="@id/offline_livestock_detail_keeper"
                    tools:text="Keeper"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_livestock_detail_owner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_taglivestock_keeper"
                    app:layout_constraintEnd_toEndOf="@id/offline_taglivestock_keeper"
                    app:layout_constraintTop_toBottomOf="@id/offline_taglivestock_keeper"
                    android:text="@string/livestock_owner"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_taglivestock_owner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_livestock_detail_owner"
                    app:layout_constraintEnd_toEndOf="@id/offline_livestock_detail_owner"
                    app:layout_constraintTop_toBottomOf="@id/offline_livestock_detail_owner"
                    tools:text="Owner"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />-->

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_livestock_detail_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_taglivestock_passport"
                    app:layout_constraintEnd_toEndOf="@id/offline_taglivestock_passport"
                    app:layout_constraintTop_toBottomOf="@id/offline_taglivestock_passport"
                    android:text="@string/livestock_type"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_taglivestock_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_livestock_detail_type"
                    app:layout_constraintEnd_toEndOf="@id/offline_livestock_detail_type"
                    app:layout_constraintTop_toBottomOf="@id/offline_livestock_detail_type"
                    tools:text="Type"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_livestock_detail_breed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_taglivestock_type"
                    app:layout_constraintEnd_toEndOf="@id/offline_taglivestock_type"
                    app:layout_constraintTop_toBottomOf="@id/offline_taglivestock_type"
                    android:text="@string/livestock_breed"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_taglivestock_breed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_livestock_detail_breed"
                    app:layout_constraintEnd_toEndOf="@id/offline_livestock_detail_breed"
                    app:layout_constraintTop_toBottomOf="@id/offline_livestock_detail_breed"
                    tools:text="Breed"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_livestock_detail_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_taglivestock_breed"
                    app:layout_constraintEnd_toEndOf="@id/offline_taglivestock_breed"
                    app:layout_constraintTop_toBottomOf="@id/offline_taglivestock_breed"
                    android:text="@string/gender"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_taglivestock_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_livestock_detail_gender"
                    app:layout_constraintEnd_toEndOf="@id/offline_livestock_detail_gender"
                    app:layout_constraintTop_toBottomOf="@id/offline_livestock_detail_gender"
                    tools:text="Gender"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_livestock_detail_health"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_taglivestock_gender"
                    app:layout_constraintEnd_toEndOf="@id/offline_taglivestock_gender"
                    app:layout_constraintTop_toBottomOf="@id/offline_taglivestock_gender"
                    android:text="@string/health_status"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_taglivestock_health"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_livestock_detail_health"
                    app:layout_constraintEnd_toEndOf="@id/offline_livestock_detail_health"
                    app:layout_constraintTop_toBottomOf="@id/offline_livestock_detail_health"
                    tools:text="Health Status"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_livestock_detail_dob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_taglivestock_health"
                    app:layout_constraintEnd_toEndOf="@id/offline_taglivestock_health"
                    app:layout_constraintTop_toBottomOf="@id/offline_taglivestock_health"
                    android:text="@string/date_of_birth"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_taglivestock_dob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_livestock_detail_dob"
                    app:layout_constraintEnd_toEndOf="@id/offline_livestock_detail_dob"
                    app:layout_constraintTop_toBottomOf="@id/offline_livestock_detail_dob"
                    tools:text="DOB"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_livestock_detail_prod_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_taglivestock_dob"
                    app:layout_constraintEnd_toEndOf="@id/offline_taglivestock_dob"
                    app:layout_constraintTop_toBottomOf="@id/offline_taglivestock_dob"
                    android:text="@string/production_type"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_taglivestock_prod_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_livestock_detail_prod_type"
                    app:layout_constraintEnd_toEndOf="@id/offline_livestock_detail_prod_type"
                    app:layout_constraintTop_toBottomOf="@id/offline_livestock_detail_prod_type"
                    tools:text="Production Type"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/twenty_dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/offline_taglivestock_prod_type"
                    android:background="@color/divider" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/offline_livestock_update_button"
                    android:text="@string/update"
                    android:drawableEnd="@drawable/ic_save"
                    style="@style/Widget.RanchID.Button.Colored.OutlinedButton"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider"
                    android:onClick="@{() -> offlineTagLivestockDetail.updateClicked()}" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/offline_taglivestock_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:visibility="invisible"
                    app:indicatorColor="@color/btn_color" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </FrameLayout>
</layout>