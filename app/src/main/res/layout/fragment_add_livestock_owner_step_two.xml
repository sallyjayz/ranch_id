<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="stepTwoViewModel"
            type="com.sallyjayz.ranchid.viewmodel.register.LivestockOwnerViewModel" />

        <variable
            name="stepTwoFragment"
            type="com.sallyjayz.ranchid.register.livestockowner.AddLivestockOwnerStepTwoFragment" />

    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".register.livestockowner.AddLivestockOwnerStepTwoFragment">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/sixteen_dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/step_two"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:text="@string/step_02_03"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="@dimen/twenty_four_sp"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/step_two_instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/step_two"
                    app:layout_constraintEnd_toEndOf="@id/step_two"
                    app:layout_constraintTop_toBottomOf="@id/step_two"
                    android:text="@string/fill_details"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/error_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_red_light"
                    app:layout_constraintBottom_toTopOf="@id/owner_nextofkin_label"
                    app:layout_constraintStart_toStartOf="@id/owner_nextofkin_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_nextofkin"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/owner_nextofkin_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/step_two_instruction"
                    app:layout_constraintEnd_toEndOf="@id/step_two_instruction"
                    app:layout_constraintTop_toBottomOf="@id/step_two_instruction"
                    android:text="@string/next_of_kin"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/owner_nextofkin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_nextofkin_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_nextofkin_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_nextofkin_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/next_of_kin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@{stepTwoViewModel.ownerNextOfKin}"
                    android:inputType="textCapCharacters"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="@dimen/sixteen_sp"
                    android:lines="1"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/owner_nextofkin_phone_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_nextofkin"
                    app:layout_constraintEnd_toEndOf="@id/owner_nextofkin"
                    app:layout_constraintTop_toBottomOf="@id/owner_nextofkin"
                    android:text="@string/next_of_kin_phone_number"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/owner_nextofkin_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_nextofkin_phone_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_nextofkin_phone_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_nextofkin_phone_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:helperTextTextColor="@color/error_red"
                    app:counterEnabled="true"
                    app:counterMaxLength="11"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/next_of_kin_phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepTwoViewModel.ownerKinPhoneNumber}"
                        android:inputType="number"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"
                        android:maxLength="11"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/owner_documenttype_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_nextofkin_phone"
                    app:layout_constraintEnd_toEndOf="@id/owner_nextofkin_phone"
                    app:layout_constraintTop_toBottomOf="@id/owner_nextofkin_phone"
                    android:text="@string/document_type"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/owner_documenttype"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_document_type"
                    app:hintTextColor="@color/black"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:layout_constraintStart_toStartOf="@id/owner_documenttype_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_documenttype_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_documenttype_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/id_document_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepTwoViewModel.ownerDocumentType}"
                        android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/owner_documentnumber_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_documenttype"
                    app:layout_constraintEnd_toEndOf="@id/owner_documenttype"
                    app:layout_constraintTop_toBottomOf="@id/owner_documenttype"
                    android:text="@string/document_number"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/owner_documentnumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_documentnumber_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_documentnumber_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_documentnumber_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:helperTextTextColor="@color/error_red"
                    app:counterEnabled="true"
                    app:counterMaxLength="16"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/document_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepTwoViewModel.ownerDocumentNumber}"
                        android:inputType="number"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"
                        android:maxLength="16"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/owner_farmlocation_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_documentnumber"
                    app:layout_constraintEnd_toEndOf="@id/owner_documentnumber"
                    app:layout_constraintTop_toBottomOf="@id/owner_documentnumber"
                    android:text="@string/farm_location"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/owner_farmlocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_farm_location"
                    app:hintTextColor="@color/black"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:layout_constraintStart_toStartOf="@id/owner_farmlocation_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_farmlocation_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_farmlocation_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/farm_location"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepTwoViewModel.ownerFarmLocation}"
                        android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!--<include
                    android:id="@+id/owner_photo_capture"
                    layout="@layout/image_capture_cardview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/owner_farmlocation"/>-->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/owner_photo_capture"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/stroke_tint"
                    app:cardElevation="0dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/owner_farmlocation">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/sixteen_dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/cameraImage"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            tools:src="@drawable/ic_launcher_background"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.RanchID.CornerSize20Dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:visibility="invisible"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/image_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Image.jpeg"
                            android:text="@{stepTwoViewModel.ownerPhotoName}"
                            android:layout_marginStart="@dimen/sixteen_dp"
                            android:textSize="@dimen/ten_sp"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/black"
                            app:layout_constraintTop_toTopOf="@id/cameraImage"
                            app:layout_constraintStart_toEndOf="@id/cameraImage"
                            android:visibility="invisible"
                            />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/image_size"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="349.42kb"
                            android:text="@{stepTwoViewModel.ownerPhotoSize}"
                            android:layout_marginStart="@dimen/sixteen_dp"
                            android:fontFamily="@font/inter_regular"
                            app:layout_constraintTop_toBottomOf="@id/image_name"
                            app:layout_constraintStart_toEndOf="@id/cameraImage"
                            android:visibility="invisible"
                            />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/re_capture_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@id/cameraImage"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:text="@string/re_capture_portrait"
                            android:backgroundTint="@color/capture_btn_background"
                            android:textColor="@color/btn_color"
                            android:layout_marginStart="@dimen/sixteen_dp"
                            android:padding="10dp"
                            android:fontFamily="@font/inter_bold"
                            android:textAllCaps="false"
                            android:paddingTop="@dimen/twenty_dp"
                            android:paddingBottom="@dimen/twenty_dp"
                            android:visibility="invisible"
                            android:onClick="@{() -> stepTwoFragment.capturedPhoto()}"/>

                        <ImageView
                            android:id="@+id/camera_icon"
                            android:layout_width="@dimen/forty_dp"
                            android:layout_height="@dimen/forty_dp"
                            android:src="@drawable/ic_camera"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/image_name"
                            android:contentDescription="@string/camera_icon" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/capture_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/camera_icon"
                            android:text="@string/capture_portrait"
                            android:backgroundTint="@color/capture_btn_background"
                            android:textColor="@color/btn_color"
                            android:padding="10dp"
                            android:fontFamily="@font/inter_bold"
                            android:textAllCaps="false"
                            android:paddingTop="@dimen/twenty_dp"
                            android:paddingBottom="@dimen/twenty_dp"
                            android:onClick="@{() -> stepTwoFragment.capturedPhoto()}"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/forty_dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/owner_photo_capture"
                    android:background="@color/divider"
                    />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/owner_second_cancel_button"
                    android:text="@string/cancel"
                    style="@style/Widget.RanchID.Button.unColored.TextButton"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider"
                    android:onClick="@{() -> stepTwoFragment.cancelButtonClicked()}"/>

                <!--<com.google.android.material.button.MaterialButton
                    android:id="@+id/owner_submit_button"
                    android:text="@string/submit"
                    android:drawableEnd="@drawable/ic_save"
                    style="@style/Widget.RanchID.Button.Colored.OutlinedButton"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider"/>-->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/owner_submit_button"
                    android:drawableEnd="@drawable/ic_next"
                    android:text="@string/next"
                    style="@style/Widget.RanchID.Button.Colored.OutlinedButton"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider"
                    android:onClick="@{() -> stepTwoFragment.nextClicked()}"/>

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/owner_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:visibility="invisible"
                    app:indicatorColor="@color/btn_color"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</layout>