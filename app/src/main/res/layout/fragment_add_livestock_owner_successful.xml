                app:layout_constraintStart_toEndOf="@+id/email"
                app:layout_constraintTop_toBottomOf="@id/nin_value"
                android:text="@{viewModel.ownerEmail}"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/black" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/address"
                app:layout_constraintTop_toBottomOf="@id/email"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/address_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/address"
                app:layout_constraintTop_toBottomOf="@id/email_value"
                android:text="@{viewModel.ownerAddress}"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/black" />

            &lt;!&ndash;<com.google.android.material.textview.MaterialTextView
                android:id="@+id/address_two"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Address Two"
                app:layout_constraintTop_toBottomOf="@id/address"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/address_two_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/address_two"
                app:layout_constraintTop_toBottomOf="@id/address_value"
                android:text="@{viewModel.ownerAddressTwo}"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/black" />&ndash;&gt;

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/state"
                android:layout_width="wrap_content"
