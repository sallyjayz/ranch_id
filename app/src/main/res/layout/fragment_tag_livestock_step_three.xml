<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="stepThreeViewModel"
            type="com.sallyjayz.ranchid.viewmodel.register.TagLivestockViewModel" />

        <variable
            name="stepThreeFragment"
            type="com.sallyjayz.ranchid.register.taglivestock.TagLivestockStepThreeFragment" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".register.taglivestock.TagLivestockStepThreeFragment">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/sixteen_dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/step_three"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:text="@string/step_03_04"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="@dimen/twenty_four_sp"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/step_three_instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/step_three"
                    app:layout_constraintEnd_toEndOf="@id/step_three"
                    app:layout_constraintTop_toBottomOf="@id/step_three"
                    android:text="@string/capture_verification_details"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/error_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_red_light"
                    app:layout_constraintBottom_toTopOf="@id/tag_description_label"
                    app:layout_constraintStart_toStartOf="@id/tag_description_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_description"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_description_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/step_three_instruction"
                    app:layout_constraintEnd_toEndOf="@id/step_three_instruction"
                    app:layout_constraintTop_toBottomOf="@id/step_three_instruction"
                    android:text="@string/description"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_description_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_description_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_description_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/description"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:text="@{stepThreeViewModel.description}"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:inputType="text|textMultiLine"
                        android:gravity="top"
                        android:scrollbars="vertical"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_tagginglocation_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_description"
                    app:layout_constraintEnd_toEndOf="@id/tag_description"
                    app:layout_constraintTop_toBottomOf="@id/tag_description"
                    android:text="@string/tagging_location"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_tagging_location"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_tagging_location"
                    app:hintTextColor="@color/black"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:layout_constraintStart_toStartOf="@id/tag_tagginglocation_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_tagginglocation_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_tagginglocation_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/tag_location"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepThreeViewModel.taggingLocation}"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_comment_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_tagging_location"
                    app:layout_constraintEnd_toEndOf="@id/tag_tagging_location"
                    app:layout_constraintTop_toBottomOf="@id/tag_tagging_location"
                    android:text="@string/comments_for_location"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_comment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_comment_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_comment_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_comment_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/comment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepThreeViewModel.locationComment}"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_productiontype_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_comment"
                    app:layout_constraintEnd_toEndOf="@id/tag_comment"
                    app:layout_constraintTop_toBottomOf="@id/tag_comment"
                    android:text="@string/production_type"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_production_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_production_type"
                    app:hintTextColor="@color/black"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:layout_constraintStart_toStartOf="@id/tag_productiontype_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_productiontype_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_productiontype_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/production_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepThreeViewModel.productionType}"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <!--<com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_secondcomment_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_production_type"
                    app:layout_constraintEnd_toEndOf="@id/tag_production_type"
                    app:layout_constraintTop_toBottomOf="@id/tag_production_type"
                    android:text="@string/comments_for_location"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_second_comment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_secondcomment_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_secondcomment_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_secondcomment_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tag_comment_two"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp" />

                </com.google.android.material.textfield.TextInputLayout>-->

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_verificationphoto_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_production_type"
                    app:layout_constraintEnd_toEndOf="@id/tag_production_type"
                    app:layout_constraintTop_toBottomOf="@id/tag_production_type"
                    android:text="@string/verification_photo"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <!--<include
                    android:id="@+id/verification_photo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/image_capture_select_cardview"
                    app:layout_constraintStart_toStartOf="@id/tag_verificationphoto_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_verificationphoto_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_verificationphoto_label"
                    android:layout_marginTop="@dimen/sixteen_dp" />-->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/verification_photo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/stroke_tint"
                    app:cardElevation="0dp"
                    app:layout_constraintStart_toStartOf="@id/tag_verificationphoto_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_verificationphoto_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_verificationphoto_label"
                    android:layout_marginTop="@dimen/sixteen_dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/sixteen_dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/verification_camera_image"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            tools:src="@drawable/ic_launcher_background"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.RanchID.CornerSize20Dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/verification_image_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Image.jpeg"
                            android:layout_marginStart="@dimen/sixteen_dp"
                            android:textSize="@dimen/ten_sp"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/black"
                            app:layout_constraintTop_toTopOf="@id/verification_camera_image"
                            app:layout_constraintStart_toEndOf="@id/verification_camera_image"
                            />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/verification_image_size"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="349.42kb"
                            android:layout_marginStart="@dimen/sixteen_dp"
                            android:fontFamily="@font/inter_regular"
                            app:layout_constraintTop_toBottomOf="@id/verification_image_name"
                            app:layout_constraintStart_toEndOf="@id/verification_camera_image"
                            />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/verification_re_capture_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@id/verification_camera_image"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:text="@string/re_capture_portrait"
                            android:backgroundTint="@color/capture_btn_background"
                            android:textColor="@color/btn_color"
                            android:layout_marginStart="@dimen/sixteen_dp"
                            android:padding="10dp"
                            android:fontFamily="@font/inter_bold"
                            android:textAllCaps="false"
                            android:paddingTop="@dimen/twenty_dp"
                            android:paddingBottom="@dimen/twenty_dp"
                            android:visibility="invisible"
                            android:onClick="@{() -> stepThreeFragment.verificationCapturedPhoto()}"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/verification_re_pick_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@id/verification_camera_image"
                            app:layout_constraintBottom_toTopOf="@id/verification_re_capture_btn"
                            android:text="@string/re_pick_image"
                            android:backgroundTint="@color/capture_btn_background"
                            android:textColor="@color/btn_color"
                            android:layout_marginStart="@dimen/sixteen_dp"
                            android:padding="10dp"
                            android:fontFamily="@font/inter_bold"
                            android:textAllCaps="false"
                            android:paddingTop="@dimen/twenty_dp"
                            android:paddingBottom="@dimen/twenty_dp"
                            android:visibility="invisible"
                            android:onClick="@{() -> stepThreeFragment.verificationPickedPhoto()}"/>

                        <ImageView
                            android:id="@+id/verification_camera_icon"
                            android:layout_width="@dimen/forty_dp"
                            android:layout_height="@dimen/forty_dp"
                            android:src="@drawable/ic_camera"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/verification_image_name"
                            android:contentDescription="@string/camera_icon" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/verification_capture_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/verification_camera_icon"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:text="@string/capture_portrait"
                            android:backgroundTint="@color/capture_btn_background"
                            android:textColor="@color/btn_color"
                            android:padding="10dp"
                            android:paddingTop="@dimen/twenty_dp"
                            android:paddingBottom="@dimen/twenty_dp"
                            android:fontFamily="@font/inter_bold"
                            android:textAllCaps="false"
                            android:onClick="@{() -> stepThreeFragment.verificationCapturedPhoto()}"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/verification_pick_image"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/verification_camera_icon"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:text="@string/pick_image"
                            android:backgroundTint="@color/capture_btn_background"
                            android:textColor="@color/btn_color"
                            android:padding="10dp"
                            android:paddingTop="@dimen/twenty_dp"
                            android:paddingBottom="@dimen/twenty_dp"
                            android:fontFamily="@font/inter_bold"
                            android:textAllCaps="false"
                            android:onClick="@{() -> stepThreeFragment.verificationPickedPhoto()}"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_muzzlephoto_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/verification_photo"
                    app:layout_constraintEnd_toEndOf="@id/verification_photo"
                    app:layout_constraintTop_toBottomOf="@id/verification_photo"
                    android:text="@string/muzzle_photo"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <!--<include
                    android:id="@+id/muzzle_photo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    layout="@layout/image_capture_select_cardview"
                    app:layout_constraintStart_toStartOf="@id/tag_muzzlephoto_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_muzzlephoto_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_muzzlephoto_label"
                    android:layout_marginTop="@dimen/sixteen_dp" />-->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/muzzle_photo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/stroke_tint"
                    app:cardElevation="0dp"
                    app:layout_constraintStart_toStartOf="@id/tag_muzzlephoto_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_muzzlephoto_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_muzzlephoto_label"
                    android:layout_marginTop="@dimen/sixteen_dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/sixteen_dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/muzzle_camera_image"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            tools:src="@drawable/ic_launcher_background"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.RanchID.CornerSize20Dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/muzzle_image_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Image.jpeg"
                            android:layout_marginStart="@dimen/sixteen_dp"
                            android:textSize="@dimen/ten_sp"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/black"
                            app:layout_constraintTop_toTopOf="@id/muzzle_camera_image"
                            app:layout_constraintStart_toEndOf="@id/muzzle_camera_image"
                            />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/muzzle_image_size"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="349.42kb"
                            android:layout_marginStart="@dimen/sixteen_dp"
                            android:fontFamily="@font/inter_regular"
                            app:layout_constraintTop_toBottomOf="@id/muzzle_image_name"
                            app:layout_constraintStart_toEndOf="@id/muzzle_camera_image"
                            />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/muzzle_re_capture_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@id/muzzle_camera_image"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:text="@string/re_capture_portrait"
                            android:backgroundTint="@color/capture_btn_background"
                            android:textColor="@color/btn_color"
                            android:layout_marginStart="@dimen/sixteen_dp"
                            android:padding="10dp"
                            android:fontFamily="@font/inter_bold"
                            android:textAllCaps="false"
                            android:paddingTop="@dimen/twenty_dp"
                            android:paddingBottom="@dimen/twenty_dp"
                            android:visibility="invisible"
                            android:onClick="@{() -> stepThreeFragment.muzzleCapturedPhoto()}"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/muzzle_re_pick_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@id/muzzle_camera_image"
                            app:layout_constraintBottom_toTopOf="@id/muzzle_re_capture_btn"
                            android:text="@string/re_pick_image"
                            android:backgroundTint="@color/capture_btn_background"
                            android:textColor="@color/btn_color"
                            android:layout_marginStart="@dimen/sixteen_dp"
                            android:padding="10dp"
                            android:fontFamily="@font/inter_bold"
                            android:textAllCaps="false"
                            android:paddingTop="@dimen/twenty_dp"
                            android:paddingBottom="@dimen/twenty_dp"
                            android:visibility="invisible"
                            android:onClick="@{() -> stepThreeFragment.muzzlePickedPhoto()}"/>

                        <ImageView
                            android:id="@+id/muzzle_camera_icon"
                            android:layout_width="@dimen/forty_dp"
                            android:layout_height="@dimen/forty_dp"
                            android:src="@drawable/ic_camera"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/muzzle_image_name"
                            android:contentDescription="@string/camera_icon" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/muzzle_capture_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/muzzle_camera_icon"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:text="@string/capture_portrait"
                            android:backgroundTint="@color/capture_btn_background"
                            android:textColor="@color/btn_color"
                            android:padding="10dp"
                            android:paddingTop="@dimen/twenty_dp"
                            android:paddingBottom="@dimen/twenty_dp"
                            android:fontFamily="@font/inter_bold"
                            android:textAllCaps="false"
                            android:onClick="@{() -> stepThreeFragment.muzzleCapturedPhoto()}"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/muzzle_pick_image"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/muzzle_camera_icon"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:text="@string/pick_image"
                            android:backgroundTint="@color/capture_btn_background"
                            android:textColor="@color/btn_color"
                            android:padding="10dp"
                            android:paddingTop="@dimen/twenty_dp"
                            android:paddingBottom="@dimen/twenty_dp"
                            android:fontFamily="@font/inter_bold"
                            android:textAllCaps="false"
                            android:onClick="@{() -> stepThreeFragment.muzzlePickedPhoto()}"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/forty_dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/muzzle_photo"
                    android:background="@color/divider" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tag_stepthree_cancel_button"
                    android:text="@string/cancel"
                    style="@style/Widget.RanchID.Button.unColored.TextButton"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider"
                    android:onClick="@{() -> stepThreeFragment.cancelButtonClicked()}"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tag_stepthree_save_button"
                    style="@style/Widget.RanchID.Button.Colored.OutlinedButton"
                    android:drawableEnd="@drawable/ic_next"
                    android:text="@string/next"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tag_stepthree_cancel_button"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:onClick="@{() -> stepThreeFragment.nextButtonClicked()}"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>
</layout>