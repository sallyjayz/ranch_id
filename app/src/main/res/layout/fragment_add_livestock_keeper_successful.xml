                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/state"
                app:layout_constraintTop_toBottomOf="@id/address_two_value"
                android:text="@{viewModel.keeperState}"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/black"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/lga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lga"
                app:layout_constraintTop_toBottomOf="@id/state"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/lga_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/lga"
                app:layout_constraintTop_toBottomOf="@id/state_value"
                android:text="@{viewModel.keeperLga}"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/black"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/next_of_kin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next of Kin"
                app:layout_constraintTop_toBottomOf="@id/lga"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/kin_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/next_of_kin"
                app:layout_constraintTop_toBottomOf="@id/lga_value"
                android:text="@{viewModel.keeperNextOfKin}"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/black"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/kin_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next of Kin Phone"
                app:layout_constraintTop_toBottomOf="@id/next_of_kin"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/kin_phone_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/kin_phone"
                app:layout_constraintTop_toBottomOf="@id/kin_value"
                android:text="@{viewModel.nextOfKinPhoneNumber}"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/black"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/document_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Document Type"
                app:layout_constraintTop_toBottomOf="@id/kin_phone"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/document_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/document_type"
                app:layout_constraintTop_toBottomOf="@id/kin_phone_value"
                android:text="@{viewModel.documentType}"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/black"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/document_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Document Number"
                app:layout_constraintTop_toBottomOf="@id/document_type"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/document_number_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/document_number"
                app:layout_constraintTop_toBottomOf="@id/document_value"
                android:text="@{viewModel.documentNumber}"
                android:fontFamily="@font/inter_bold"
                android:textColor="@color/black"/>-->


        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>
</layout>