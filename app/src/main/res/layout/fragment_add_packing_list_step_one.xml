<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="stepOneViewModel"
            type="com.sallyjayz.ranchid.viewmodel.packinglist.PackingListViewModel" />

        <variable
            name="stepOneFragment"
            type="com.sallyjayz.ranchid.register.packinglist.AddPackingListStepOneFragment" />

    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".register.packinglist.AddPackingListStepOneFragment">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/sixteen_dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/offline"
                    android:drawableStart="@drawable/ic_warning"
                    android:fontFamily="@font/inter_regular"
                    android:background="@color/offline_background"
                    android:textColor="@color/offline_text"
                    android:padding="@dimen/four_dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/step_one"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/offline_tv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:text="@string/step_01_03"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="@dimen/twenty_four_sp"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/step_one_instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/step_one"
                    app:layout_constraintEnd_toEndOf="@id/step_one"
                    app:layout_constraintTop_toBottomOf="@id/step_one"
                    android:text="@string/fill_details"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/error_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_red_light"
                    app:layout_constraintBottom_toTopOf="@id/driver_name_label"
                    app:layout_constraintStart_toStartOf="@id/driver_name_label"
                    app:layout_constraintEnd_toEndOf="@id/driver_name_input"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/driver_name_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/step_one_instruction"
                    app:layout_constraintEnd_toEndOf="@id/step_one_instruction"
                    app:layout_constraintTop_toBottomOf="@id/step_one_instruction"
                    android:text="@string/driver_name"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/driver_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/driver_name_label"
                    app:layout_constraintEnd_toEndOf="@id/driver_name_label"
                    app:layout_constraintTop_toBottomOf="@id/driver_name_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/driver_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:fontFamily="@font/inter_regular"
                        android:text="@{stepOneViewModel.driverName}"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/vehicle_name_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/driver_name_input"
                    app:layout_constraintEnd_toEndOf="@id/driver_name_input"
                    app:layout_constraintTop_toBottomOf="@id/driver_name_input"
                    android:text="@string/vehicle_name"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/vehicle_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/vehicle_name_label"
                    app:layout_constraintEnd_toEndOf="@id/vehicle_name_label"
                    app:layout_constraintTop_toBottomOf="@id/vehicle_name_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/vehicle_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:fontFamily="@font/inter_regular"
                        android:text="@{stepOneViewModel.vehicleName}"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/reg_no_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/vehicle_name_input"
                    app:layout_constraintEnd_toEndOf="@id/vehicle_name_input"
                    app:layout_constraintTop_toBottomOf="@id/vehicle_name_input"
                    android:text="@string/registration_number"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/reg_no_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/reg_no_label"
                    app:layout_constraintEnd_toEndOf="@id/reg_no_label"
                    app:layout_constraintTop_toBottomOf="@id/reg_no_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/reg_no"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:fontFamily="@font/inter_regular"
                        android:text="@{stepOneViewModel.regNumber}"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/livestock_type_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/reg_no_input"
                    app:layout_constraintEnd_toEndOf="@id/reg_no_input"
                    app:layout_constraintTop_toBottomOf="@id/reg_no_input"
                    android:text="@string/livestock_type"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/livestock_type_dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_livestock_type"
                    app:hintTextColor="@color/black"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:layout_constraintStart_toStartOf="@id/livestock_type_label"
                    app:layout_constraintEnd_toEndOf="@id/livestock_type_label"
                    app:layout_constraintTop_toBottomOf="@id/livestock_type_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    >

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/livestock_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.packingLivestockType}"
                        android:inputType="none"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!--<com.google.android.material.textview.MaterialTextView
                    android:id="@+id/livestock_qty_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/livestock_type_dropdown"
                    app:layout_constraintEnd_toEndOf="@id/livestock_type_dropdown"
                    app:layout_constraintTop_toBottomOf="@id/livestock_type_dropdown"
                    android:text="@string/livestock_quantity"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/livestock_qty_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/livestock_qty_label"
                    app:layout_constraintEnd_toEndOf="@id/livestock_qty_label"
                    app:layout_constraintTop_toBottomOf="@id/livestock_qty_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/livestock_qty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:fontFamily="@font/inter_regular"
                        android:text="@{stepOneViewModel.livestockQty}"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"/>
                </com.google.android.material.textfield.TextInputLayout>-->

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/destination_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/livestock_type_dropdown"
                    app:layout_constraintEnd_toEndOf="@id/livestock_type_dropdown"
                    app:layout_constraintTop_toBottomOf="@id/livestock_type_dropdown"
                    android:text="@string/destination"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/destination_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/destination_label"
                    app:layout_constraintEnd_toEndOf="@id/destination_label"
                    app:layout_constraintTop_toBottomOf="@id/destination_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:fontFamily="@font/inter_regular"
                        android:text="@{stepOneViewModel.destination}"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/livestock_state_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/destination_input"
                    app:layout_constraintEnd_toEndOf="@id/destination_input"
                    app:layout_constraintTop_toBottomOf="@id/destination_input"
                    android:text="@string/state"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/livestock_state_dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_state"
                    app:hintTextColor="@color/black"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:layout_constraintStart_toStartOf="@id/livestock_state_label"
                    app:layout_constraintEnd_toEndOf="@id/livestock_state_label"
                    app:layout_constraintTop_toBottomOf="@id/livestock_state_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    >

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.packingState}"
                        android:inputType="none"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/livestock_lga_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/livestock_state_dropdown"
                    app:layout_constraintEnd_toEndOf="@id/livestock_state_dropdown"
                    app:layout_constraintTop_toBottomOf="@id/livestock_state_dropdown"
                    android:text="@string/lga"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/livestock_lga_dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_lga"
                    app:hintTextColor="@color/black"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:layout_constraintStart_toStartOf="@id/livestock_lga_label"
                    app:layout_constraintEnd_toEndOf="@id/livestock_lga_label"
                    app:layout_constraintTop_toBottomOf="@id/livestock_lga_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    >

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/lga"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.packingLga}"
                        android:inputType="none"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/forty_dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/livestock_lga_dropdown"
                    android:background="@color/divider"
                    />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancel_button"
                    android:text="@string/cancel"
                    style="@style/Widget.RanchID.Button.unColored.TextButton"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider"
                    android:onClick="@{() -> stepOneFragment.cancelButtonClicked()}"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/next_button"
                    android:text="@string/next"
                    android:enabled="false"
                    android:alpha="0.5"
                    android:drawableEnd="@drawable/ic_next"
                    style="@style/Widget.RanchID.Button.Colored.OutlinedButton"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider"
                    android:onClick="@{() -> stepOneFragment.nextButtonClicked()}"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </FrameLayout>
</layout>