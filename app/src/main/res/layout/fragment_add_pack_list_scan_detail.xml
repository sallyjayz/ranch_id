                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/packing_detail_health"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/packing_detail_livestock_health"
                    app:layout_constraintEnd_toEndOf="@id/packing_detail_livestock_health"
                    app:layout_constraintTop_toBottomOf="@id/packing_detail_livestock_health"
                    tools:text="Okay"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black"/>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/livestock_health_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/packing_detail_health"
                    android:layout_marginTop="@dimen/eight_dp"
                    android:background="@color/divider"/>-->

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/packing_detail_livestock_dob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/livestock_gender_divider"
                    app:layout_constraintEnd_toEndOf="@id/livestock_gender_divider"
                    app:layout_constraintTop_toBottomOf="@id/livestock_gender_divider"
                    android:text="@string/date_of_birth"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/packing_detail_dob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/packing_detail_livestock_dob"
                    app:layout_constraintEnd_toEndOf="@id/packing_detail_livestock_dob"
                    app:layout_constraintTop_toBottomOf="@id/packing_detail_livestock_dob"
                    tools:text="12 December, 2022"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black"/>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/livestock_dob_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/packing_detail_dob"
                    android:layout_marginTop="@dimen/eight_dp"
                    android:background="@color/divider"/>

                <!--<com.google.android.material.textview.MaterialTextView
                    android:id="@+id/packing_detail_livestock_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/livestock_dob_divider"
                    app:layout_constraintEnd_toEndOf="@id/livestock_dob_divider"
                    app:layout_constraintTop_toBottomOf="@id/livestock_dob_divider"
                    android:text="@string/description"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
