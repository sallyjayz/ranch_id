<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="stepOneViewModel"
            type="com.sallyjayz.ranchid.viewmodel.register.LivestockOwnerViewModel" />
        <variable
            name="stepOneFragment"
            type="com.sallyjayz.ranchid.register.livestockowner.AddLivestockOwnerStepOneFragment" />

    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".register.livestockowner.AddLivestockOwnerStepOneFragment">


        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/sixteen_dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/step_one"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:text="@string/step_01_03"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="@dimen/twenty_four_sp"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/step_one_instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/step_one"
                    app:layout_constraintEnd_toEndOf="@id/step_one"
                    app:layout_constraintTop_toBottomOf="@id/step_one"
                    android:text="@string/fill_details"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/error_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_red_light"
                    app:layout_constraintBottom_toTopOf="@id/ownership_type_label"
                    app:layout_constraintStart_toStartOf="@id/ownership_type_label"
                    app:layout_constraintEnd_toEndOf="@id/ownership_type_dropdown"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/ownership_type_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/step_one_instruction"
                    app:layout_constraintEnd_toEndOf="@id/step_one_instruction"
                    app:layout_constraintTop_toBottomOf="@id/step_one_instruction"
                    android:text="@string/ownership_type"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/ownership_type_dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_ownership_type"
                    app:hintTextColor="@color/black"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:layout_constraintStart_toStartOf="@id/ownership_type_label"
                    app:layout_constraintEnd_toEndOf="@id/ownership_type_label"
                    app:layout_constraintTop_toBottomOf="@id/ownership_type_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    >

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/owner_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.ownerType}"
                        android:inputType="none"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/group_name_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/ownership_type_dropdown"
                    app:layout_constraintEnd_toEndOf="@id/ownership_type_dropdown"
                    app:layout_constraintTop_toBottomOf="@id/ownership_type_dropdown"
                    android:text="@string/group_name"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black"
                    android:visibility="gone"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/group_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/group_name_label"
                    app:layout_constraintEnd_toEndOf="@id/group_name_label"
                    app:layout_constraintTop_toBottomOf="@id/group_name_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/group_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.groupName}"
                        android:inputType="textCapCharacters"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"/>
                </com.google.android.material.textfield.TextInputLayout>


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/owner_questionkeeper_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/group_name_input"
                    app:layout_constraintEnd_toEndOf="@id/group_name_input"
                    app:layout_constraintTop_toBottomOf="@id/group_name_input"
                    android:text="@string/are_you_a_livestock_keeper"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <RadioGroup
                    android:id="@+id/owner_questionkeeper_radiogroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="@id/owner_questionkeeper_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_questionkeeper_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_questionkeeper_label">

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:id="@+id/owner_keeperyes_radiobutton"
                        android:text="@string/yes"
                        android:checked="@{stepOneViewModel.OwnerLivestockKeeper.equals(@string/yes)}"
                        android:fontFamily="@font/inter_regular"
                        android:onClick="@{() -> stepOneViewModel.setLivestockKeeper(@string/yes)}"/>

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:id="@+id/owner_keeperno_radiobutton"
                        android:text="@string/no"
                        android:checked="@{stepOneViewModel.OwnerLivestockKeeper.equals(@string/no)}"
                        android:fontFamily="@font/inter_regular"
                        android:onClick="@{() -> stepOneViewModel.setLivestockKeeper(@string/no)}"/>
                </RadioGroup>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/owner_surname_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_questionkeeper_radiogroup"
                    app:layout_constraintEnd_toEndOf="@id/owner_questionkeeper_radiogroup"
                    app:layout_constraintTop_toBottomOf="@id/owner_questionkeeper_radiogroup"
                    android:text="@string/surname"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/owner_surname_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_surname_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_surname_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_surname_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/surname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.ownerSurname}"
                        android:inputType="textCapCharacters"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/owner_othername_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_surname_input"
                    app:layout_constraintEnd_toEndOf="@id/owner_surname_input"
                    app:layout_constraintTop_toBottomOf="@id/owner_surname_input"
                    android:text="@string/other_names"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/owner_othername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAllCaps="true"
                    app:layout_constraintStart_toStartOf="@id/owner_othername_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_othername_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_othername_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/othername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.ownerOthername}"
                        android:inputType="textCapCharacters"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/owner_gender_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_othername"
                    app:layout_constraintEnd_toEndOf="@id/owner_othername"
                    app:layout_constraintTop_toBottomOf="@id/owner_othername"
                    android:text="@string/gender"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <RadioGroup
                    android:id="@+id/owner_genderquestion_radiogroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="@id/owner_gender_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_gender_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_gender_label">

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:id="@+id/owner_male_radiobutton"
                        android:text="@string/male"
                        android:checked="@{stepOneViewModel.OwnerGender.equals(@string/male)}"
                        android:fontFamily="@font/inter_regular"
                        android:onClick="@{() -> stepOneViewModel.setGender(@string/male)}"/>

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:id="@+id/owner_female_radiobutton"
                        android:text="@string/female"
                        android:checked="@{stepOneViewModel.OwnerGender.equals(@string/female)}"
                        android:fontFamily="@font/inter_regular"
                        android:onClick="@{() -> stepOneViewModel.setGender(@string/female)}"/>
                </RadioGroup>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/owner_marital_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/owner_gender_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_genderquestion_radiogroup"
                    android:text="@string/marital_status"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <RadioGroup
                    android:id="@+id/owner_maritalquestion_radiogroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="@id/owner_marital_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_gender_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_marital_label">

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:id="@+id/owner_single"
                        android:text="@string/single"
                        android:checked="@{stepOneViewModel.ownerMaritalStatus.equals(@string/single)}"
                        android:fontFamily="@font/inter_regular"
                        android:onClick="@{() -> stepOneViewModel.setMaritalStatus(@string/single)}" />

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:id="@+id/owner_married"
                        android:text="@string/married"
                        android:checked="@{stepOneViewModel.ownerMaritalStatus.equals(@string/married)}"
                        android:fontFamily="@font/inter_regular"
                        android:onClick="@{() -> stepOneViewModel.setMaritalStatus(@string/married)}"/>
                </RadioGroup>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/owner_dob_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_maritalquestion_radiogroup"
                    app:layout_constraintEnd_toEndOf="@id/owner_maritalquestion_radiogroup"
                    app:layout_constraintTop_toBottomOf="@id/owner_maritalquestion_radiogroup"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:text="@string/date_of_birth"
                    app:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/owner_dob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_dob_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_dob_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_dob_label"
                    android:hint="@string/select_date_of_birth"
                    app:hintTextColor="@color/black"
                    android:textColorHint="@color/black"
                    app:startIconContentDescription="@string/date_icon"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/dob"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="date"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"
                        android:text="@{stepOneViewModel.ownerDateOfBirth}"
                        android:onClick="@{() -> stepOneFragment.dateOfBirth()}"
                        android:focusableInTouchMode="false"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/owner_phoneno_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_dob"
                    app:layout_constraintEnd_toEndOf="@id/owner_dob"
                    app:layout_constraintTop_toBottomOf="@id/owner_dob"
                    android:text="@string/phone_number"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/owner_phoneno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_phoneno_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_phoneno_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_phoneno_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:helperTextTextColor="@color/error_red"
                    app:counterEnabled="true"
                    app:counterMaxLength="11"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phone_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.ownerPhoneNumber}"
                        android:inputType="phone"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"
                        android:maxLength="11"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/owner_nin_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_phoneno"
                    app:layout_constraintEnd_toEndOf="@id/owner_phoneno"
                    app:layout_constraintTop_toBottomOf="@id/owner_phoneno"
                    android:text="@string/nin"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/owner_nin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_nin_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_nin_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_nin_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:helperTextTextColor="@color/error_red"
                    app:counterEnabled="true"
                    app:counterMaxLength="16"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nin_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.ownerNin}"
                        android:inputType="number"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"
                        android:maxLength="16"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/owner_email_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_nin"
                    app:layout_constraintEnd_toEndOf="@id/owner_nin"
                    app:layout_constraintTop_toBottomOf="@id/owner_nin"
                    android:text="@string/email"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/owner_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_email_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_email_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_email_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:helperTextTextColor="@color/error_red"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.ownerEmail}"
                        android:inputType="textEmailAddress"
                        android:lines="1"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/owner_address_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_email"
                    app:layout_constraintEnd_toEndOf="@id/owner_email"
                    app:layout_constraintTop_toBottomOf="@id/owner_email"
                    android:text="@string/address"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/owner_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_address_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_address_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_address_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.ownerAddress}"
                        android:fontFamily="@font/inter_regular"
                        android:inputType="text|textMultiLine"
                        android:textSize="@dimen/sixteen_sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!--<com.google.android.material.textview.MaterialTextView
                    android:id="@+id/owner_addresstwo_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_addressone"
                    app:layout_constraintEnd_toEndOf="@id/owner_addressone"
                    app:layout_constraintTop_toBottomOf="@id/owner_addressone"
                    android:text="@string/address_2"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/owner_addresstwo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_addresstwo_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_addresstwo_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_addresstwo_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/address_two"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:inputType="text|textMultiLine"
                        android:textSize="@dimen/sixteen_sp" />
                </com.google.android.material.textfield.TextInputLayout>-->

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/owner_state_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_address"
                    app:layout_constraintEnd_toEndOf="@id/owner_address"
                    app:layout_constraintTop_toBottomOf="@id/owner_address"
                    android:text="@string/state"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/owner_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:layout_constraintStart_toStartOf="@id/owner_state_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_state_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_state_label"
                    android:hint="@string/select_state"
                    app:hintTextColor="@color/black"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    >

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.ownerState}"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/owner_lga_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_state"
                    app:layout_constraintEnd_toEndOf="@id/owner_state"
                    app:layout_constraintTop_toBottomOf="@id/owner_state"
                    android:text="@string/local_government_area"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/owner_lga"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:layout_constraintStart_toStartOf="@id/owner_lga_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_lga_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_lga_label"
                    android:hint="@string/select_lga"
                    app:hintTextColor="@color/black"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    >

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/lga"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.ownerLga}"
                        android:inputType="none"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/forty_dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/owner_lga"
                    android:background="@color/divider"
                    />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/owner_cancel_button"
                    android:text="@string/cancel"
                    style="@style/Widget.RanchID.Button.unColored.TextButton"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider"
                    android:onClick="@{() -> stepOneFragment.cancelButtonClicked()}"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/owner_next_button"
                    android:text="@string/next"
                    android:drawableEnd="@drawable/ic_next"
                    style="@style/Widget.RanchID.Button.Colored.OutlinedButton"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider"
                    android:onClick="@{() -> stepOneFragment.nextButtonClicked()}"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>
</layout>