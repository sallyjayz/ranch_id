<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="stepOneViewModel"
            type="com.sallyjayz.ranchid.viewmodel.register.LivestockKeeperViewModel" />
        
        <variable
            name="stepOneFragment"
            type="com.sallyjayz.ranchid.register.livestockkeeper.AddLivestockKeeperStepOneFragment" />

    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".register.livestockkeeper.AddLivestockKeeperStepOneFragment">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/sixteen_dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/step_one"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:text="@string/step_01_03"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="@dimen/twenty_four_sp"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/step_one_instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/step_one"
                    app:layout_constraintEnd_toEndOf="@id/step_one"
                    app:layout_constraintTop_toBottomOf="@id/step_one"
                    android:text="@string/fill_details"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/error_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_red_light"
                    app:layout_constraintBottom_toTopOf="@id/keeper_surname_label"
                    app:layout_constraintStart_toStartOf="@id/keeper_surname_label"
                    app:layout_constraintEnd_toEndOf="@id/keeper_surname"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/keeper_surname_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/step_one_instruction"
                    app:layout_constraintEnd_toEndOf="@id/step_one_instruction"
                    app:layout_constraintTop_toBottomOf="@id/step_one_instruction"
                    android:text="@string/surname"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/keeper_surname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/keeper_surname_label"
                    app:layout_constraintEnd_toEndOf="@id/keeper_surname_label"
                    app:layout_constraintTop_toBottomOf="@id/keeper_surname_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/surname"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:text="@{stepOneViewModel.surname}"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/keeper_othername_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/keeper_surname"
                    app:layout_constraintEnd_toEndOf="@id/keeper_surname"
                    app:layout_constraintTop_toBottomOf="@id/keeper_surname"
                    android:text="@string/other_names"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/keeper_othername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAllCaps="true"
                    app:layout_constraintStart_toStartOf="@id/keeper_othername_label"
                    app:layout_constraintEnd_toEndOf="@id/keeper_othername_label"
                    app:layout_constraintTop_toBottomOf="@id/keeper_othername_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/othername"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.othername}"
                        android:inputType="textCapCharacters"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/keeper_gender_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/keeper_othername"
                    app:layout_constraintEnd_toEndOf="@id/keeper_othername"
                    app:layout_constraintTop_toBottomOf="@id/keeper_othername"
                    android:text="@string/gender"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <RadioGroup
                    android:id="@+id/keeper_genderquestion_radiogroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="@id/keeper_gender_label"
                    app:layout_constraintEnd_toEndOf="@id/keeper_gender_label"
                    app:layout_constraintTop_toBottomOf="@id/keeper_gender_label">

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:id="@+id/keeper_male"
                        android:text="@string/male"
                        android:checked="@{stepOneViewModel.keeperGender.equals(@string/male)}"
                        android:fontFamily="@font/inter_regular"
                        android:onClick="@{() -> stepOneViewModel.setGender(@string/male)}" />

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:id="@+id/keeper_female"
                        android:text="@string/female"
                        android:checked="@{stepOneViewModel.keeperGender.equals(@string/female)}"
                        android:fontFamily="@font/inter_regular"
                        android:onClick="@{() -> stepOneViewModel.setGender(@string/female)}"/>
                </RadioGroup>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/keeper_marital_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/keeper_genderquestion_radiogroup"
                    app:layout_constraintEnd_toEndOf="@id/keeper_genderquestion_radiogroup"
                    app:layout_constraintTop_toBottomOf="@id/keeper_genderquestion_radiogroup"
                    android:text="@string/marital_status"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <RadioGroup
                    android:id="@+id/keeper_maritalquestion_radiogroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="@id/keeper_marital_label"
                    app:layout_constraintEnd_toEndOf="@id/keeper_marital_label"
                    app:layout_constraintTop_toBottomOf="@id/keeper_marital_label">

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:id="@+id/keeper_single"
                        android:text="@string/single"
                        android:checked="@{stepOneViewModel.keeperMaritalStatus.equals(@string/single)}"
                        android:fontFamily="@font/inter_regular"
                        android:onClick="@{() -> stepOneViewModel.setMaritalStatus(@string/single)}" />

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:id="@+id/keeper_married"
                        android:text="@string/married"
                        android:checked="@{stepOneViewModel.keeperMaritalStatus.equals(@string/married)}"
                        android:fontFamily="@font/inter_regular"
                        android:onClick="@{() -> stepOneViewModel.setMaritalStatus(@string/married)}"/>
                </RadioGroup>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/keeper_dob_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/keeper_maritalquestion_radiogroup"
                    app:layout_constraintEnd_toEndOf="@id/keeper_maritalquestion_radiogroup"
                    app:layout_constraintTop_toBottomOf="@id/keeper_maritalquestion_radiogroup"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:text="@string/date_of_birth"
                    app:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/keeper_dob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/keeper_dob_label"
                    app:layout_constraintEnd_toEndOf="@id/keeper_dob_label"
                    app:layout_constraintTop_toBottomOf="@id/keeper_dob_label"
                    android:hint="@string/select_date_of_birth"
                    app:hintTextColor="@color/black"
                    android:textColorHint="@color/black"
                    app:startIconContentDescription="@string/date_icon"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/dob"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="date"
                        android:textSize="@dimen/sixteen_sp"
                        android:text="@{stepOneViewModel.keeperDateOfBirth}"
                        android:onClick="@{() -> stepOneFragment.dateOfBirth()}"
                        android:focusableInTouchMode="false"
                        android:lines="1"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/keeper_phoneno_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/keeper_dob"
                    app:layout_constraintEnd_toEndOf="@id/keeper_dob"
                    app:layout_constraintTop_toBottomOf="@id/keeper_dob"
                    android:text="@string/phone_number"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/keeper_phoneno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/keeper_phoneno_label"
                    app:layout_constraintEnd_toEndOf="@id/keeper_phoneno_label"
                    app:layout_constraintTop_toBottomOf="@id/keeper_phoneno_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:helperTextTextColor="@color/error_red"
                    app:counterEnabled="true"
                    app:counterMaxLength="11"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phone_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.phoneNumber}"
                        android:inputType="phone"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"
                        android:maxLength="11"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/keeper_nin_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/keeper_phoneno"
                    app:layout_constraintEnd_toEndOf="@id/keeper_phoneno"
                    app:layout_constraintTop_toBottomOf="@id/keeper_phoneno"
                    android:text="@string/nin"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/keeper_nin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/keeper_nin_label"
                    app:layout_constraintEnd_toEndOf="@id/keeper_nin_label"
                    app:layout_constraintTop_toBottomOf="@id/keeper_nin_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:helperTextTextColor="@color/error_red"
                    app:counterEnabled="true"
                    app:counterMaxLength="16"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nin_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.nin}"
                        android:inputType="number"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"
                        android:maxLength="16"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/owner_email_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/keeper_nin"
                    app:layout_constraintEnd_toEndOf="@id/keeper_nin"
                    app:layout_constraintTop_toBottomOf="@id/keeper_nin"
                    android:text="@string/email"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/keeper_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/owner_email_label"
                    app:layout_constraintEnd_toEndOf="@id/owner_email_label"
                    app:layout_constraintTop_toBottomOf="@id/owner_email_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:helperTextTextColor="@color/error_red"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.email}"
                        android:inputType="textEmailAddress"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/keeper_address_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/keeper_email"
                    app:layout_constraintEnd_toEndOf="@id/keeper_email"
                    app:layout_constraintTop_toBottomOf="@id/keeper_email"
                    android:text="@string/address"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/keeper_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/keeper_address_label"
                    app:layout_constraintEnd_toEndOf="@id/keeper_address_label"
                    app:layout_constraintTop_toBottomOf="@id/keeper_address_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.address}"
                        android:fontFamily="@font/inter_regular"
                        android:inputType="text|textMultiLine"
                        android:textSize="@dimen/sixteen_sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!--<com.google.android.material.textview.MaterialTextView
                    android:id="@+id/keeper_addresstwo_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/keeper_addressone"
                    app:layout_constraintEnd_toEndOf="@id/keeper_addressone"
                    app:layout_constraintTop_toBottomOf="@id/keeper_addressone"
                    android:text="@string/address_2"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/keeper_addresstwo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/keeper_addresstwo_label"
                    app:layout_constraintEnd_toEndOf="@id/keeper_addresstwo_label"
                    app:layout_constraintTop_toBottomOf="@id/keeper_addresstwo_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/address_two"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:inputType="text|textMultiLine"
                        android:textSize="@dimen/sixteen_sp" />
                </com.google.android.material.textfield.TextInputLayout>-->

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/keeper_state_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/keeper_address"
                    app:layout_constraintEnd_toEndOf="@id/keeper_address"
                    app:layout_constraintTop_toBottomOf="@id/keeper_address"
                    android:text="@string/state"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/keeper_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:layout_constraintStart_toStartOf="@id/keeper_state_label"
                    app:layout_constraintEnd_toEndOf="@id/keeper_state_label"
                    app:layout_constraintTop_toBottomOf="@id/keeper_state_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    android:hint="@string/select_state"
                    app:hintTextColor="@color/black"
                    >

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.keeperState}"
                        android:inputType="none"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/keeper_lga_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/keeper_state"
                    app:layout_constraintEnd_toEndOf="@id/keeper_state"
                    app:layout_constraintTop_toBottomOf="@id/keeper_state"
                    android:text="@string/local_government_area"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/keeper_lga"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:layout_constraintStart_toStartOf="@id/keeper_lga_label"
                    app:layout_constraintEnd_toEndOf="@id/keeper_lga_label"
                    app:layout_constraintTop_toBottomOf="@id/keeper_lga_label"
                    android:hint="@string/select_lga"
                    app:hintTextColor="@color/black"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    >

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/lga"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepOneViewModel.keeperLga}"
                        android:inputType="none"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/forty_dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/keeper_lga"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:background="@color/divider"
                    />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keeper_cancel_button"
                    android:text="@string/cancel"
                    style="@style/Widget.RanchID.Button.unColored.TextButton"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider"
                    android:onClick="@{() -> stepOneFragment.cancelButtonClicked()}"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keeper_next_button"
                    android:text="@string/next"
                    android:drawableEnd="@drawable/ic_next"
                    style="@style/Widget.RanchID.Button.Colored.OutlinedButton"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider"
                    android:onClick="@{() -> stepOneFragment.nextButtonClicked()}"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>
</layout>