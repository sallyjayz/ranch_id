<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="treatmentStepOne"
            type="com.sallyjayz.ranchid.veterinaryDoctor.livestockTreatment.LivestockTreatmentOneFragment" />


    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".veterinaryDoctor.livestockTreatment.LivestockTreatmentOneFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/sixteen_dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/step_one"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="@string/step_01_04"
                android:fontFamily="@font/inter_bold"
                android:textSize="@dimen/twenty_four_sp"
                android:textColor="@color/black" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/step_one_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@id/step_one"
                app:layout_constraintEnd_toEndOf="@id/step_one"
                app:layout_constraintTop_toBottomOf="@id/step_one"
                tools:text="@string/scan_livestock_tag"
                android:textSize="@dimen/eighteen_sp"
                android:fontFamily="@font/inter_bold" />

            <androidx.camera.view.PreviewView
                android:id="@+id/tag_livestock_scanimage"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="@dimen/sixteen_dp"
                app:layout_constraintEnd_toEndOf="@id/step_one_instruction"
                app:layout_constraintStart_toStartOf="@id/step_one_instruction"
                app:layout_constraintTop_toBottomOf="@id/step_one_instruction" />

            <ImageView
            android:id="@+id/barcode_boundary"
            android:layout_width="300dp"
            android:layout_height="250dp"
            app:layout_constraintEnd_toEndOf="@id/tag_livestock_scanimage"
            app:layout_constraintStart_toStartOf="@id/tag_livestock_scanimage"
            app:layout_constraintTop_toTopOf="@id/tag_livestock_scanimage"
            app:layout_constraintBottom_toBottomOf="@id/tag_livestock_scanimage"
            android:contentDescription="@null" />

            <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tag_livestock_tag_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/tag_livestock_scanimage"
            app:layout_constraintTop_toBottomOf="@id/tag_livestock_scanimage"
            android:text="@string/scanned_tag_id"
            android:layout_marginTop="@dimen/sixteen_dp"
            android:textSize="@dimen/eighteen_sp"
            android:fontFamily="@font/inter_bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tag_livestock_tag"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/tag_livestock_tag_label"
                app:layout_constraintTop_toBottomOf="@id/tag_livestock_scanimage"
                app:layout_constraintEnd_toEndOf="@id/tag_livestock_scanimage"
                android:layout_marginTop="@dimen/sixteen_dp"
                android:layout_marginStart="@dimen/sixteen_dp"
                tools:text="NGF0009038"
                android:textSize="@dimen/eighteen_sp"
                android:fontFamily="@font/inter_bold" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tag_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tag_livestock_tag"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="@dimen/sixteen_dp"
                android:textSize="@dimen/eighteen_sp"
                android:fontFamily="@font/inter_bold" />

            <com.google.android.material.divider.MaterialDivider
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/forty_dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tag_error"
                android:background="@color/divider" />

            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tag_livestock_next_button"
                android:text="@string/next"
                android:textAllCaps="false"
                android:paddingTop="@dimen/twenty_dp"
                android:paddingBottom="@dimen/twenty_dp"
                android:paddingStart="@dimen/forty_dp"
                android:paddingEnd="@dimen/forty_dp"
                android:textSize="@dimen/eighteen_sp"
                android:backgroundTint="@color/nait_blue"
                android:textColor="@color/white"
                android:drawableEnd="@drawable/ic_next"
                style="@style/Widget.MaterialComponents.Button.Icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider"
                android:onClick="@{() -> treatmentStepOne.nextButtonClicked()}" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>
</layout>