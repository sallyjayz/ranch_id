<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="stepFourViewModel"
            type="com.sallyjayz.ranchid.viewmodel.vet.LivestockTreatmentViewModel" />

        <variable
            name="stepFourFragment"
            type="com.sallyjayz.ranchid.veterinaryDoctor.livestockTreatment.LivestockTreatmentFourFragment" />

    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".veterinaryDoctor.livestockTreatment.LivestockTreatmentFourFragment">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/sixteen_dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/step_four"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:text="@string/step_04_04"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="@dimen/twenty_four_sp"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/step_four_instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/step_four"
                    app:layout_constraintEnd_toEndOf="@id/step_four"
                    app:layout_constraintTop_toBottomOf="@id/step_four"
                    android:text="@string/livestock_treatment"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/error_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_red_light"
                    app:layout_constraintTop_toBottomOf="@id/step_four_instruction"
                    app:layout_constraintStart_toStartOf="@id/step_four_instruction"
                    app:layout_constraintEnd_toEndOf="@id/step_four_instruction"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tag_photo_capture"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/stroke_tint"
                    app:cardElevation="0dp"
                    app:layout_constraintStart_toStartOf="@id/error_tv"
                    app:layout_constraintEnd_toEndOf="@id/error_tv"
                    app:layout_constraintTop_toBottomOf="@id/error_tv">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/sixteen_dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/camera_image"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            tools:src="@drawable/ic_launcher_background"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.RanchID.CornerSize20Dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:visibility="invisible"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/image_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Image.jpeg"
                            android:text="@{stepFourViewModel.photoName}"
                            android:layout_marginStart="@dimen/sixteen_dp"
                            android:textSize="@dimen/ten_sp"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/black"
                            app:layout_constraintTop_toTopOf="@id/camera_image"
                            app:layout_constraintStart_toEndOf="@id/camera_image"
                            android:visibility="invisible"
                            />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/image_size"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="349.42kb"
                            android:text="@{stepFourViewModel.photoSize}"
                            android:layout_marginStart="@dimen/sixteen_dp"
                            android:fontFamily="@font/inter_regular"
                            app:layout_constraintTop_toBottomOf="@id/image_name"
                            app:layout_constraintStart_toEndOf="@id/camera_image"
                            android:visibility="invisible"
                            />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/re_capture_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@id/camera_image"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:text="@string/reupload"
                            android:backgroundTint="@color/capture_btn_background"
                            android:textColor="@color/btn_color"
                            android:layout_marginStart="@dimen/sixteen_dp"
                            android:padding="10dp"
                            android:fontFamily="@font/inter_bold"
                            android:textAllCaps="false"
                            android:paddingTop="@dimen/twenty_dp"
                            android:paddingBottom="@dimen/twenty_dp"
                            android:visibility="invisible"
                            android:onClick="@{() -> stepFourFragment.uploadImage()}"/>

                        <ImageView
                            android:id="@+id/camera_icon"
                            android:layout_width="@dimen/forty_dp"
                            android:layout_height="@dimen/forty_dp"
                            android:src="@drawable/ic_camera"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/image_name"
                            android:contentDescription="@string/camera_icon" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/capture_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/camera_icon"
                            android:text="@string/upload_image"
                            android:backgroundTint="@color/capture_btn_background"
                            android:textColor="@color/btn_color"
                            android:padding="10dp"
                            android:fontFamily="@font/inter_bold"
                            android:textAllCaps="false"
                            android:paddingTop="@dimen/twenty_dp"
                            android:paddingBottom="@dimen/twenty_dp"
                            android:onClick="@{() -> stepFourFragment.uploadImage()}"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_follow_up_date_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_photo_capture"
                    app:layout_constraintEnd_toEndOf="@id/tag_photo_capture"
                    app:layout_constraintTop_toBottomOf="@id/tag_photo_capture"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:text="@string/follow_up_date"
                    app:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_follow_up_date_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_follow_up_date_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_follow_up_date_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_follow_up_date_label"
                    android:hint="@string/select_follow_up_date"
                    app:hintTextColor="@color/black"
                    android:textColorHint="@color/black"
                    app:startIconContentDescription="@string/date_icon"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/follow_up_date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="date"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"
                        android:text="@{stepFourViewModel.followUpDate}"
                        android:onClick="@{() -> stepFourFragment.followUpDate()}"
                        android:focusableInTouchMode="false"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_notes_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_follow_up_date_input"
                    app:layout_constraintEnd_toEndOf="@id/tag_follow_up_date_input"
                    app:layout_constraintTop_toBottomOf="@id/tag_follow_up_date_input"
                    android:text="@string/additional_notes"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_notes_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_notes_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_notes_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_notes_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tag_notes"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:text="@{stepFourViewModel.notes}"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:inputType="text|textMultiLine"
                        android:gravity="top"
                        android:scrollbars="vertical"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tag_stepthree_cancel_button"
                    android:text="@string/cancel"
                    android:layout_marginTop="@dimen/thirty_two_dp"
                    style="@style/Widget.RanchID.Button.unColored.TextButton"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tag_notes_input"
                    android:onClick="@{() -> stepFourFragment.cancelButtonClicked()}"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tag_stepthree_save_button"
                    style="@style/Widget.RanchID.Button.Colored.OutlinedButton"
                    android:drawableEnd="@drawable/ic_next"
                    android:text="@string/next"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tag_stepthree_cancel_button"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:onClick="@{() -> stepFourFragment.nextButtonClicked()}"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>


    </FrameLayout>
</layout>

