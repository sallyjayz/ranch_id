<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="stepThreeViewModel"
            type="com.sallyjayz.ranchid.viewmodel.vet.LivestockTreatmentViewModel" />

        <variable
            name="stepThreeFragment"
            type="com.sallyjayz.ranchid.veterinaryDoctor.livestockTreatment.LivestockTreatmentThreeFragment" />

    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".veterinaryDoctor.livestockTreatment.LivestockTreatmentThreeFragment">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/sixteen_dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/step_three"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:text="@string/step_03_04"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="@dimen/twenty_four_sp"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/step_three_instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/step_three"
                    app:layout_constraintEnd_toEndOf="@id/step_three"
                    app:layout_constraintTop_toBottomOf="@id/step_three"
                    android:text="@string/livestock_treatment"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/error_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_red_light"
                    app:layout_constraintTop_toBottomOf="@id/step_three_instruction"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_id_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/error_tv"
                    android:text="@string/scanned_tag_id"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_id_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined"
                    app:layout_constraintStart_toStartOf="@id/tag_id_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_id_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_id_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tag_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_time_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_id_input"
                    app:layout_constraintEnd_toEndOf="@id/tag_id_input"
                    app:layout_constraintTop_toBottomOf="@id/tag_id_input"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:text="@string/treatment_time"
                    app:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_time_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_time_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_time_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_time_label"
                    android:hint="@string/select_treatment_time"
                    app:hintTextColor="@color/black"
                    android:textColorHint="@color/black"
                    app:startIconContentDescription="@string/date_icon"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_time"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="time"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"
                        android:text="@{stepThreeViewModel.timeOfTreatment}"
                        android:onClick="@{() -> stepThreeFragment.timeOfTreatment()}"
                        android:focusableInTouchMode="false"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_date_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_time_input"
                    app:layout_constraintEnd_toEndOf="@id/tag_time_input"
                    app:layout_constraintTop_toBottomOf="@id/tag_time_input"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:text="@string/treatment_date"
                    app:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_date_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_date_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_date_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_date_label"
                    android:hint="@string/select_treatment_date"
                    app:hintTextColor="@color/black"
                    android:textColorHint="@color/black"
                    app:startIconContentDescription="@string/date_icon"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="date"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"
                        android:text="@{stepThreeViewModel.dateOfTreatment}"
                        android:onClick="@{() -> stepThreeFragment.dateOfTreatment()}"
                        android:focusableInTouchMode="false"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_treatment_category_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_date_input"
                    app:layout_constraintEnd_toEndOf="@id/tag_date_input"
                    app:layout_constraintTop_toBottomOf="@id/tag_date_input"
                    android:text="@string/treatment_category"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_treatment_category_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_treatment_category"
                    app:hintTextColor="@color/black"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:layout_constraintStart_toStartOf="@id/tag_treatment_category_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_treatment_category_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_treatment_category_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/tag_treatment_category"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepThreeViewModel.treatmentCategory}"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_treatment_type_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_treatment_category_input"
                    app:layout_constraintEnd_toEndOf="@id/tag_treatment_category_input"
                    app:layout_constraintTop_toBottomOf="@id/tag_treatment_category_input"
                    android:text="@string/treatment_type"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_treatment_type_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_treatment_type"
                    app:hintTextColor="@color/black"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:layout_constraintStart_toStartOf="@id/tag_treatment_type_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_treatment_type_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_treatment_type_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/tag_treatment_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepThreeViewModel.treatmentType}"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_drug_vaccine_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_treatment_type_input"
                    app:layout_constraintEnd_toEndOf="@id/tag_treatment_type_input"
                    app:layout_constraintTop_toBottomOf="@id/tag_treatment_type_input"
                    android:text="@string/drug_vaccine"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_drug_vaccine_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined"
                    app:layout_constraintStart_toStartOf="@id/tag_drug_vaccine_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_drug_vaccine_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_drug_vaccine_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tag_drug_vaccine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepThreeViewModel.vaccine}"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_drug_dosage_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tag_drug_vaccine_input"
                    android:text="@string/drug_dosage"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_drug_dosage_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined"
                    app:layout_constraintStart_toStartOf="@id/tag_drug_dosage_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_drug_dosage_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_drug_dosage_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tag_drug_dosage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepThreeViewModel.dosage}"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_frequency_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_drug_dosage_input"
                    app:layout_constraintEnd_toEndOf="@id/tag_drug_dosage_input"
                    app:layout_constraintTop_toBottomOf="@id/tag_drug_dosage_input"
                    android:text="@string/frequency"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_frequency_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_frequency"
                    app:hintTextColor="@color/black"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:layout_constraintStart_toStartOf="@id/tag_frequency_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_frequency_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_frequency_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/tag_frequency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepThreeViewModel.frequency}"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_administration_route_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_frequency_input"
                    app:layout_constraintEnd_toEndOf="@id/tag_frequency_input"
                    app:layout_constraintTop_toBottomOf="@id/tag_frequency_input"
                    android:text="@string/administration_route"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_administration_route_dropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_administration_route"
                    app:hintTextColor="@color/black"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:layout_constraintStart_toStartOf="@id/tag_administration_route_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_administration_route_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_administration_route_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    >

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/administration_route"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepThreeViewModel.administrationRoute}"
                        android:inputType="none"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_injection_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_administration_route_dropdown"
                    app:layout_constraintEnd_toEndOf="@id/tag_administration_route_dropdown"
                    app:layout_constraintTop_toBottomOf="@id/tag_administration_route_dropdown"
                    android:text="@string/injection"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black"
                    android:visibility="gone"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_injection_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_injection"
                    app:layout_constraintStart_toStartOf="@id/tag_injection_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_injection_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_injection_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:visibility="gone">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/injection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepThreeViewModel.injection}"
                        android:inputType="none"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_diagnosis_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_injection_input"
                    app:layout_constraintEnd_toEndOf="@id/tag_injection_input"
                    app:layout_constraintTop_toBottomOf="@id/tag_injection_input"
                    android:text="@string/diagnosis"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_diagnosis_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined"
                    app:layout_constraintStart_toStartOf="@id/tag_diagnosis_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_diagnosis_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_diagnosis_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tag_diagnosis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepThreeViewModel.diagnosis}"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tag_stepthree_cancel_button"
                    android:text="@string/cancel"
                    android:layout_marginTop="@dimen/thirty_two_dp"
                    style="@style/Widget.RanchID.Button.unColored.TextButton"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tag_diagnosis_input"
                    android:onClick="@{() -> stepThreeFragment.cancelButtonClicked()}"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tag_stepthree_save_button"
                    style="@style/Widget.RanchID.Button.Colored.OutlinedButton"
                    android:drawableEnd="@drawable/ic_next"
                    android:text="@string/next"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tag_stepthree_cancel_button"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:onClick="@{() -> stepThreeFragment.nextButtonClicked()}"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </FrameLayout>
</layout>