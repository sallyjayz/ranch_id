<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="packingListViewModel"
            type="com.sallyjayz.ranchid.viewmodel.packinglist.PackingListViewModel" />

        <variable
            name="packingListStepThree"
            type="com.sallyjayz.ranchid.register.packinglist.AddPackingListStepThreeFragment" />

    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".register.packinglist.AddPackingListStepThreeFragment">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/sixteen_dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/offline"
                    android:drawableStart="@drawable/ic_warning"
                    android:fontFamily="@font/inter_regular"
                    android:background="@color/offline_background"
                    android:textColor="@color/offline_text"
                    android:padding="@dimen/four_dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/step_three"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/offline_tv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:text="@string/step_03_03"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="@dimen/twenty_four_sp"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/form_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/step_three"
                    app:layout_constraintEnd_toEndOf="@id/step_three"
                    app:layout_constraintTop_toBottomOf="@id/step_three"
                    android:text="@string/form_summary"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/error_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_red_light"
                    app:layout_constraintBottom_toTopOf="@id/driver_label"
                    app:layout_constraintStart_toStartOf="@id/driver_label"
                    app:layout_constraintEnd_toEndOf="@id/driver_label"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/driver_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/form_summary"
                    app:layout_constraintEnd_toEndOf="@id/form_summary"
                    app:layout_constraintTop_toBottomOf="@id/form_summary"
                    android:text="@string/driver_name"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/thirty_two_dp"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/driver_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/driver_label"
                    app:layout_constraintEnd_toEndOf="@id/driver_label"
                    app:layout_constraintTop_toBottomOf="@id/driver_label"
                    tools:text="Oselu"
                    android:text="@{packingListViewModel.driverName}"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black"/>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/driver_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/driver_name"
                    android:layout_marginTop="@dimen/eight_dp"
                    android:background="@color/divider"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/vehicle_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/driver_divider"
                    app:layout_constraintEnd_toEndOf="@id/driver_divider"
                    app:layout_constraintTop_toBottomOf="@id/driver_divider"
                    android:text="@string/vehicle_name"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/vehicle_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/vehicle_label"
                    app:layout_constraintEnd_toEndOf="@id/vehicle_label"
                    app:layout_constraintTop_toBottomOf="@id/vehicle_label"
                    tools:text="FH 456 FDE"
                    android:text="@{packingListViewModel.vehicleName}"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black"/>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/vehicle_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/vehicle_name"
                    android:layout_marginTop="@dimen/eight_dp"
                    android:background="@color/divider"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/reg_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/vehicle_divider"
                    app:layout_constraintEnd_toEndOf="@id/vehicle_divider"
                    app:layout_constraintTop_toBottomOf="@id/vehicle_divider"
                    android:text="@string/registration_number"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/reg_no"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/reg_label"
                    app:layout_constraintEnd_toEndOf="@id/reg_label"
                    app:layout_constraintTop_toBottomOf="@id/reg_label"
                    tools:text="1234"
                    android:text="@{packingListViewModel.regNumber}"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black"/>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/reg_no_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/reg_no"
                    android:layout_marginTop="@dimen/eight_dp"
                    android:background="@color/divider"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/livestock_type_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/reg_no_divider"
                    app:layout_constraintEnd_toEndOf="@id/reg_no_divider"
                    app:layout_constraintTop_toBottomOf="@id/reg_no_divider"
                    android:text="@string/livestock_type"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/livestock_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/livestock_type_label"
                    app:layout_constraintEnd_toEndOf="@id/livestock_type_label"
                    app:layout_constraintTop_toBottomOf="@id/livestock_type_label"
                    tools:text="Cattle"
                    android:text="@{packingListViewModel.packingLivestockType}"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black"/>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/type_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/livestock_type"
                    android:layout_marginTop="@dimen/eight_dp"
                    android:background="@color/divider"/>

                <!--<com.google.android.material.textview.MaterialTextView
                    android:id="@+id/livestock_qty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/type_divider"
                    app:layout_constraintEnd_toEndOf="@id/type_divider"
                    app:layout_constraintTop_toBottomOf="@id/type_divider"
                    android:text="@string/livestock_quantity"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/livestock_quantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/livestock_qty"
                    app:layout_constraintEnd_toEndOf="@id/livestock_qty"
                    app:layout_constraintTop_toBottomOf="@id/livestock_qty"
                    tools:text="50"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black"/>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/quantity_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/livestock_quantity"
                    android:layout_marginTop="@dimen/eight_dp"
                    android:background="@color/divider"/>-->

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/livestock_destination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/type_divider"
                    app:layout_constraintEnd_toEndOf="@id/type_divider"
                    app:layout_constraintTop_toBottomOf="@id/type_divider"
                    android:text="@string/destination"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/destination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/livestock_destination"
                    app:layout_constraintEnd_toEndOf="@id/livestock_destination"
                    app:layout_constraintTop_toBottomOf="@id/livestock_destination"
                    tools:text="Benin"
                    android:text="@{packingListViewModel.destination}"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black"/>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/destination_divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/destination"
                    android:layout_marginTop="@dimen/eight_dp"
                    android:background="@color/divider"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/livestock_list_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_next"
                    android:drawableTint="@color/black"
                    android:text="@string/livestock_list"
                    android:layout_marginTop="@dimen/twenty_dp"
                    android:padding="15dp"
                    app:strokeColor="@color/black"
                    style="?attr/materialButtonOutlinedStyle"
                    android:backgroundTint="#E1E2E7"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/destination_divider"
                    android:onClick="@{() -> packingListStepThree.livestockListClicked()}"/>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/forty_dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/livestock_list_btn"
                    android:background="@color/divider" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/submit_button"
                    android:text="@string/submit"
                    android:enabled="false"
                    android:alpha="0.5"
                    android:drawableEnd="@drawable/ic_save"
                    style="@style/Widget.RanchID.Button.Colored.OutlinedButton"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider"
                    android:onClick="@{() -> packingListStepThree.submitClicked()}"/>

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:visibility="invisible"
                    app:indicatorColor="@android:color/black"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </FrameLayout>
</layout>