<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="stepThreeViewModel"
            type="com.sallyjayz.ranchid.viewmodel.vet.LivestockVaccinationViewModel"/>

        <variable
            name="stepThreeFragment"
            type="com.sallyjayz.ranchid.veterinaryDoctor.vaccinateLivestock.VaccinateLivestockThreeFragment" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".veterinaryDoctor.vaccinateLivestock.VaccinateLivestockThreeFragment">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/sixteen_dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/step_three"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:text="@string/step_03_04"
                    android:fontFamily="@font/inter_bold"
                    android:textSize="@dimen/twenty_four_sp"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/step_three_instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/step_three"
                    app:layout_constraintEnd_toEndOf="@id/step_three"
                    app:layout_constraintTop_toBottomOf="@id/step_three"
                    android:text="@string/vaccinate_livestock"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/error_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_red_light"
                    app:layout_constraintTop_toBottomOf="@id/step_three_instruction"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_id_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/error_tv"
                    android:text="@string/scanned_tag_id"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_id_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined"
                    app:layout_constraintStart_toStartOf="@id/tag_id_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_id_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_id_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tag_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapCharacters"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_livestock_type_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tag_id_input"
                    android:text="@string/livestock_type"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_livestock_type_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_livestock_type"
                    app:hintTextColor="@color/black"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:layout_constraintStart_toStartOf="@id/tag_livestock_type_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_livestock_type_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_livestock_type_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/tag_livestock_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepThreeViewModel.livestockType}"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_drug_vaccine_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tag_livestock_type_input"
                    android:text="@string/drug_vaccine"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_drug_vaccine_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_drug_vaccine"
                    app:hintTextColor="@color/black"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:layout_constraintStart_toStartOf="@id/tag_drug_vaccine_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_drug_vaccine_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_drug_vaccine_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/tag_drug_vaccine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepThreeViewModel.vaccine}"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_drug_dosage_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tag_drug_vaccine_input"
                    android:text="@string/drug_dosage"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_drug_dosage_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined"
                    app:layout_constraintStart_toStartOf="@id/tag_drug_dosage_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_drug_dosage_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_drug_dosage_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tag_drug_dosage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepThreeViewModel.dosage}"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_frequency_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tag_drug_dosage_input"
                    android:text="@string/frequency"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_frequency_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_frequency"
                    app:hintTextColor="@color/black"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    app:layout_constraintStart_toStartOf="@id/tag_frequency_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_frequency_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_frequency_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/tag_frequency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepThreeViewModel.frequency}"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_time_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_frequency_input"
                    app:layout_constraintEnd_toEndOf="@id/tag_frequency_input"
                    app:layout_constraintTop_toBottomOf="@id/tag_frequency_input"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:text="@string/time_of_vaccination"
                    app:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_time_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_time_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_time_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_time_label"
                    android:hint="@string/select_time_of_vaccination"
                    app:hintTextColor="@color/black"
                    android:textColorHint="@color/black"
                    app:startIconContentDescription="@string/date_icon"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_time"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="time"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"
                        android:text="@{stepThreeViewModel.timeOfVaccination}"
                        android:onClick="@{() -> stepThreeFragment.timeOfVaccination()}"
                        android:focusableInTouchMode="false"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_date_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_time_input"
                    app:layout_constraintEnd_toEndOf="@id/tag_time_input"
                    app:layout_constraintTop_toBottomOf="@id/tag_time_input"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:text="@string/date_of_vaccination"
                    app:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_date_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_date_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_date_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_date_label"
                    android:hint="@string/select_date_of_vaccination"
                    app:hintTextColor="@color/black"
                    android:textColorHint="@color/black"
                    app:startIconContentDescription="@string/date_icon"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/date"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="date"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"
                        android:text="@{stepThreeViewModel.dateOfVaccination}"
                        android:onClick="@{() -> stepThreeFragment.dateOfVaccination()}"
                        android:focusableInTouchMode="false"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_next_appointment_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_date_input"
                    app:layout_constraintEnd_toEndOf="@id/tag_date_input"
                    app:layout_constraintTop_toBottomOf="@id/tag_date_input"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:text="@string/next_appointment"
                    app:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_next_appointment_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_next_appointment_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_next_appointment_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_next_appointment_label"
                    android:hint="@string/select_date_for_next_appointment"
                    app:hintTextColor="@color/black"
                    android:textColorHint="@color/black"
                    app:startIconContentDescription="@string/date_icon"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/next_appointment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="date"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"
                        android:text="@{stepThreeViewModel.dateOfNextAppointment}"
                        android:onClick="@{() -> stepThreeFragment.nextAppointmentDate()}"
                        android:focusableInTouchMode="false"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_notes_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_next_appointment_input"
                    app:layout_constraintEnd_toEndOf="@id/tag_next_appointment_input"
                    app:layout_constraintTop_toBottomOf="@id/tag_next_appointment_input"
                    android:text="@string/additional_notes"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:textColor="@color/black" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_notes_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/tag_notes_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_notes_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_notes_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/tag_notes"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:text="@{stepThreeViewModel.notes}"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:inputType="text|textMultiLine"
                        android:gravity="top"
                        android:scrollbars="vertical"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tag_photo_capture"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/stroke_tint"
                    app:cardElevation="0dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tag_notes_input">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="@dimen/sixteen_dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/camera_image"
                            android:layout_width="150dp"
                            android:layout_height="150dp"
                            tools:src="@drawable/ic_launcher_background"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.RanchID.CornerSize20Dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:visibility="invisible"/>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/image_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Image.jpeg"
                            android:text="@{stepThreeViewModel.photoName}"
                            android:layout_marginStart="@dimen/sixteen_dp"
                            android:textSize="@dimen/ten_sp"
                            android:fontFamily="@font/inter_bold"
                            android:textColor="@color/black"
                            app:layout_constraintTop_toTopOf="@id/camera_image"
                            app:layout_constraintStart_toEndOf="@id/camera_image"
                            android:visibility="invisible"
                            />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/image_size"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="349.42kb"
                            android:text="@{stepThreeViewModel.photoSize}"
                            android:layout_marginStart="@dimen/sixteen_dp"
                            android:fontFamily="@font/inter_regular"
                            app:layout_constraintTop_toBottomOf="@id/image_name"
                            app:layout_constraintStart_toEndOf="@id/camera_image"
                            android:visibility="invisible"
                            />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/re_capture_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@id/camera_image"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:text="@string/reupload"
                            android:backgroundTint="@color/capture_btn_background"
                            android:textColor="@color/btn_color"
                            android:layout_marginStart="@dimen/sixteen_dp"
                            android:padding="10dp"
                            android:fontFamily="@font/inter_bold"
                            android:textAllCaps="false"
                            android:paddingTop="@dimen/twenty_dp"
                            android:paddingBottom="@dimen/twenty_dp"
                            android:visibility="invisible"
                            android:onClick="@{() -> stepThreeFragment.uploadImage()}"/>

                        <ImageView
                            android:id="@+id/camera_icon"
                            android:layout_width="@dimen/forty_dp"
                            android:layout_height="@dimen/forty_dp"
                            android:src="@drawable/ic_camera"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/image_name"
                            android:contentDescription="@string/camera_icon" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/capture_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/camera_icon"
                            android:text="@string/upload_image"
                            android:backgroundTint="@color/capture_btn_background"
                            android:textColor="@color/btn_color"
                            android:padding="10dp"
                            android:fontFamily="@font/inter_bold"
                            android:textAllCaps="false"
                            android:paddingTop="@dimen/twenty_dp"
                            android:paddingBottom="@dimen/twenty_dp"
                            android:onClick="@{() -> stepThreeFragment.uploadImage()}"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tag_stepthree_cancel_button"
                    android:text="@string/cancel"
                    android:layout_marginTop="@dimen/thirty_two_dp"
                    style="@style/Widget.RanchID.Button.unColored.TextButton"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tag_photo_capture"
                    android:onClick="@{() -> stepThreeFragment.cancelButtonClicked()}"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tag_stepthree_save_button"
                    style="@style/Widget.RanchID.Button.Colored.OutlinedButton"
                    android:drawableEnd="@drawable/ic_next"
                    android:text="@string/next"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tag_stepthree_cancel_button"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:onClick="@{() -> stepThreeFragment.nextButtonClicked()}"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </FrameLayout>
</layout>