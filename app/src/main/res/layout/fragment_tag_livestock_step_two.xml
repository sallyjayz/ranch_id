<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="stepTwoViewModel"
            type="com.sallyjayz.ranchid.viewmodel.register.TagLivestockViewModel" />

        <variable
            name="stepTwoFragment"
            type="com.sallyjayz.ranchid.register.taglivestock.TagLivestockStepTwoFragment"
            />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".register.taglivestock.TagLivestockStepTwoFragment">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/sixteen_dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/step_two"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/step_02_04"
                    android:textColor="@color/black"
                    android:textSize="@dimen/twenty_four_sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/step_one_instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/fill_details"
                    android:textSize="@dimen/eighteen_sp"
                    app:layout_constraintEnd_toEndOf="@id/step_two"
                    app:layout_constraintStart_toStartOf="@id/step_two"
                    app:layout_constraintTop_toBottomOf="@id/step_two" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/error_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_red_light"
                    app:layout_constraintBottom_toTopOf="@id/tag_scanid_label"
                    app:layout_constraintStart_toStartOf="@id/tag_scanid_label"
                    app:layout_constraintEnd_toEndOf="@id/tag_scanid"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_scanid_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/scanned_tag"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="@id/step_one_instruction"
                    app:layout_constraintStart_toStartOf="@id/step_one_instruction"
                    app:layout_constraintTop_toBottomOf="@id/step_one_instruction" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_scanid"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:layout_constraintEnd_toEndOf="@id/tag_scanid_label"
                    app:layout_constraintStart_toStartOf="@id/tag_scanid_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_scanid_label">

                    <!--<com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/scan_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepTwoViewModel.scannedTagId}"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"/>-->
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/scan_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_passport_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/passport_id"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="@id/tag_scanid"
                    app:layout_constraintStart_toStartOf="@id/tag_scanid"
                    app:layout_constraintTop_toBottomOf="@id/tag_scanid" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_passport"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_passport_id"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:hintTextColor="@color/black"
                    app:layout_constraintEnd_toEndOf="@id/tag_passport_label"
                    app:layout_constraintStart_toStartOf="@id/tag_passport_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_passport_label">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/passport_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepTwoViewModel.passportId}"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_livestockkeeper_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/livestock_keeper"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="@id/tag_passport"
                    app:layout_constraintStart_toStartOf="@id/tag_passport"
                    app:layout_constraintTop_toBottomOf="@id/tag_passport" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_livestock_keeper"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_livestock_keeper"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:hintTextColor="@color/black"
                    app:layout_constraintEnd_toEndOf="@id/tag_livestockkeeper_label"
                    app:layout_constraintStart_toStartOf="@id/tag_livestockkeeper_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_livestockkeeper_label">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/livestock_keeper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepTwoViewModel.livestockKeeper}"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_livestockowner_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/livestock_owner"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="@id/tag_livestock_keeper"
                    app:layout_constraintStart_toStartOf="@id/tag_livestock_keeper"
                    app:layout_constraintTop_toBottomOf="@id/tag_livestock_keeper" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_livestock_owner"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_livestock_owner"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:hintTextColor="@color/black"
                    app:layout_constraintEnd_toEndOf="@id/tag_livestockowner_label"
                    app:layout_constraintStart_toStartOf="@id/tag_livestockowner_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_livestockowner_label">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/livestock_owner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepTwoViewModel.livestockOwner}"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_livestocktype_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/livestock_type"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="@id/tag_livestock_owner"
                    app:layout_constraintStart_toStartOf="@id/tag_livestock_owner"
                    app:layout_constraintTop_toBottomOf="@id/tag_livestock_owner" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_livestock_type"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_livestock_type"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:hintTextColor="@color/black"
                    app:layout_constraintEnd_toEndOf="@id/tag_livestocktype_label"
                    app:layout_constraintStart_toStartOf="@id/tag_livestocktype_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_livestocktype_label">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/livestock_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:text="@{stepTwoViewModel.livestockType}" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_livestockbreed_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/livestock_breed"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="@id/tag_livestock_type"
                    app:layout_constraintStart_toStartOf="@id/tag_livestock_type"
                    app:layout_constraintTop_toBottomOf="@id/tag_livestock_type" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_livestock_breed"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_livestock_breed"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:hintTextColor="@color/black"
                    app:layout_constraintEnd_toEndOf="@id/tag_livestockbreed_label"
                    app:layout_constraintStart_toStartOf="@id/tag_livestockkeeper_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_livestockbreed_label">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/livestock_breed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepTwoViewModel.livestockBreed}"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_gender_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/gender"
                    android:textColor="@color/black"
                    app:layout_constraintStart_toStartOf="@id/tag_livestock_breed"
                    app:layout_constraintTop_toBottomOf="@id/tag_livestock_breed" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_gender"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_gender"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:hintTextColor="@color/black"
                    android:layout_marginEnd="@dimen/eight_dp"
                    app:layout_constraintStart_toStartOf="@id/tag_gender_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_gender_label"
                    app:layout_constraintEnd_toStartOf="@id/guideline">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/gender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepTwoViewModel.gender}"
                        android:inputType="none" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_healthstatus_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/health_status"
                    android:textColor="@color/black"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:layout_marginStart="@dimen/eight_dp"
                    app:layout_constraintStart_toStartOf="@id/guideline"
                    app:layout_constraintTop_toBottomOf="@id/tag_livestock_breed"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_health_status"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/eight_dp"
                    android:hint="@string/select_status"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:hintTextColor="@color/black"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/guideline"
                    app:layout_constraintTop_toBottomOf="@id/tag_healthstatus_label">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/health_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@{stepTwoViewModel.healthStatus}"
                        android:inputType="none"/>

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_dob_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/date_of_birth"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="@id/tag_health_status"
                    app:layout_constraintStart_toStartOf="@id/tag_gender"
                    app:layout_constraintTop_toBottomOf="@id/tag_gender" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_dob"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_date_of_birth"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:endIconMode="custom"
                    app:hintTextColor="@color/black"
                    app:layout_constraintEnd_toEndOf="@id/tag_dob_label"
                    app:layout_constraintStart_toStartOf="@id/tag_dob_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_dob_label"
                    app:startIconContentDescription="@string/date_icon">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/dob"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sixteen_sp"
                        android:text="@{stepTwoViewModel.dateOfBirth}"
                        android:onClick="@{() -> stepTwoFragment.dateOfBirth()}"
                        android:focusableInTouchMode="false"
                        android:lines="1"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!--<com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tag_birthperiod_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    android:fontFamily="@font/inter_bold"
                    android:text="@string/select_birth_period"
                    android:textColor="@color/black"
                    app:layout_constraintEnd_toEndOf="@id/tag_dob"
                    app:layout_constraintStart_toStartOf="@id/tag_dob"
                    app:layout_constraintTop_toBottomOf="@id/tag_dob" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tag_birth_period"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/select_birth_period"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:endIconDrawable="@drawable/ic_calendar"
                    app:endIconMode="custom"
                    app:hintTextColor="@color/black"
                    app:layout_constraintEnd_toEndOf="@id/tag_birthperiod_label"
                    app:layout_constraintStart_toStartOf="@id/tag_birthperiod_label"
                    app:layout_constraintTop_toBottomOf="@id/tag_birthperiod_label"
                    app:startIconContentDescription="@string/date_icon">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/birth_period"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sixteen_sp"
                        android:onClick="@{() -> stepTwoFragment.periodOfBirth()}"
                        android:focusableInTouchMode="false"/>

                </com.google.android.material.textfield.TextInputLayout>-->

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/forty_dp"
                    android:background="@color/divider"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tag_dob" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tag_cancel_button"
                    style="@style/Widget.RanchID.Button.unColored.TextButton"
                    android:text="@string/cancel"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider"
                    android:onClick="@{() -> stepTwoFragment.cancelButtonClicked()}"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tag_save_button"
                    style="@style/Widget.RanchID.Button.Colored.OutlinedButton"
                    android:drawableEnd="@drawable/ic_next"
                    android:text="@string/next"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tag_cancel_button"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:onClick="@{() -> stepTwoFragment.nextButtonClicked()}"/>

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent=".50" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </FrameLayout>
</layout>