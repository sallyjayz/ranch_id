<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="offlineOwnerDetail"
            type="com.sallyjayz.ranchid.offline.livestockowner.OfflineOwnerDetailFragment" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".offline.livestockowner.OfflineOwnerDetailFragment">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/sixteen_dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/error_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:textAlignment="center"
                    android:textColor="@android:color/holo_red_light"
                    app:layout_constraintBottom_toTopOf="@id/offline_owner_detail_type"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_detail_type"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_detail_type"/>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_detail_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:text="@string/ownership_type"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_detail_type"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_detail_type"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_detail_type"
                    tools:text="Ownership Type"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_detail_surname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_type"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_type"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_type"
                    android:text="@string/surname"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_surname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_detail_surname"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_detail_surname"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_detail_surname"
                    tools:text="Owner Surname"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_detail_othername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/other_names"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_surname"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_surname"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_surname" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_othername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_detail_othername"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_detail_othername"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_detail_othername"
                    tools:text="Owner othername"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_detail_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/gender"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_othername"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_othername"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_othername" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_detail_gender"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_detail_gender"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_detail_gender"
                    tools:text="Gender"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_detail_marital"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/marital_status"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_gender"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_gender"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_gender" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_marital"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_detail_marital"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_detail_marital"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_detail_marital"
                    tools:text="Marital Status"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_detail_dob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/date_of_birth"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_marital"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_marital"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_marital" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_dob"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_detail_dob"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_detail_dob"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_detail_dob"
                    tools:text="Date of Birth"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_detail_phone_no"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/phone_number"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_dob"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_dob"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_dob" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/offline_owner_phoneno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_detail_phone_no"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_detail_phone_no"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_detail_phone_no"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:helperTextTextColor="@color/error_red"
                    app:counterEnabled="true"
                    app:counterMaxLength="11"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phone_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"
                        android:maxLength="11" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_detail_nin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nin"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_phoneno"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_phoneno"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_phoneno" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/offline_owner_nin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_detail_nin"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_detail_nin"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_detail_nin"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:helperTextTextColor="@color/error_red"
                    app:counterEnabled="true"
                    app:counterMaxLength="16"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nin_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"
                        android:maxLength="16" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_detail_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/email"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_nin"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_nin"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_nin" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/offline_owner_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_detail_email"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_detail_email"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_detail_email"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:helperTextTextColor="@color/error_red"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_detail_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/address"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_email"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_email"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_email" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_detail_address"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_detail_address"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_detail_address"
                    tools:text="Address"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />


                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_detail_kin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/next_of_kin"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_address"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_address"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_address" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_kin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_detail_kin"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_detail_kin"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_detail_kin"
                    tools:text="Next of Kin"
                    android:textSize="@dimen/eighteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:textColor="@color/black" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/offline_owner_detail_kin_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/next_of_kin_phone_number"
                    android:textSize="@dimen/sixteen_sp"
                    android:fontFamily="@font/inter_bold"
                    android:layout_marginTop="@dimen/sixteen_dp"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_kin"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_kin"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_kin" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/offline_owner_kin_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="@id/offline_owner_detail_kin_phone"
                    app:layout_constraintEnd_toEndOf="@id/offline_owner_detail_kin_phone"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_detail_kin_phone"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/stroke_tint"
                    app:helperTextTextColor="@color/error_red"
                    app:counterEnabled="true"
                    app:counterMaxLength="11"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:theme="@style/ThemeOverlay.RanchId.TextInputEditText.Outlined">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/kin_phone_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/sixteen_sp"
                        android:lines="1"
                        android:maxLength="11" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/twenty_dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/offline_owner_kin_phone"
                    android:background="@color/divider" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/offline_owner_update_button"
                    android:text="@string/update"
                    android:drawableEnd="@drawable/ic_save"
                    style="@style/Widget.RanchID.Button.Colored.OutlinedButton"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider"
                    android:onClick="@{() -> offlineOwnerDetail.updateClicked()}" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/offline_keeper_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:visibility="invisible"
                    app:indicatorColor="@color/btn_color" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </FrameLayout>
</layout>