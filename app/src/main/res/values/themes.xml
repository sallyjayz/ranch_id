<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <!--<style name="Theme.RanchID" parent="Theme.MaterialComponents.DayNight.DarkActionBar">-->
    <style name="Theme.RanchID" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/nait_blue</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <!-- Customize your theme here. -->
        <item name="android:colorBackground">?attr/colorPrimaryVariant</item>
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
        <item name="navigationViewStyle">@style/Widget.RanchID.NavigationView</item>
        <item name="radioButtonStyle">@style/Widget.RanchID.RadioButton</item>
        <item name="tabStyle">@style/Widget.RanchID.TabLayout</item>
        <item name="materialCalendarTheme">@style/ThemeOverlay.RanchID.DatePicker</item>
<!--        <item name="textInputStyle">@style/Widget.RanchID.TextInputLayout</item>-->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.RanchID.MaterialAlertDialog</item>
        <item name="android:windowAnimationStyle">@style/ActivityAnimation</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Ranch.BottomSheetDialog</item>
        <item name="materialTimePickerTheme">@style/MaterialTimePickerStyle</item>
    </style>

    <style name="ShapeAppearanceOverlay.RanchID.CornerSize50Percent" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearanceOverlay.RanchID.CornerSize20Dp" parent="">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Widget.App.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="textAppearanceBody2">@style/TextAppearance.RanchID.Body2</item>
    </style>

    <style name="Widget.RanchID.NavigationView" parent="Widget.MaterialComponents.NavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.NavigationView</item>
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
        <item name="itemShapeFillColor">@color/nav_item_background_color</item>
    </style>

    <style name="ThemeOverlay.App.NavigationView" parent="">
        <item name="colorPrimary">@color/nait_blue</item>
        <item name="colorSurface">@color/primary</item>
        <item name="colorOnSurface">@color/second_text_color</item>
        <item name="textAppearanceBody2">@style/TextAppearance.RanchID.Body2</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.RanchID.SmallComponent</item>
    </style>

    <style name="ShapeAppearance.RanchID.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="TextAppearance.RanchID.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>

    <style name="Widget.RanchID.Button.Colored.OutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAppearance">@style/TextAppearance.RanchID.Button</item>
        <item name="android:backgroundTint">@color/btn_color</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="textAllCaps">false</item>
        <item name="android:textSize">@dimen/sixteen_sp</item>
        <item name="android:paddingTop">@dimen/ten_dp</item>
        <item name="android:paddingBottom">@dimen/ten_dp</item>
        <item name="android:paddingStart">@dimen/forty_dp</item>
        <item name="android:paddingEnd">@dimen/thirty_two_dp</item>
    </style>

    <style name="Widget.RanchID.Button.unColored.TextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.RanchID.Button</item>
        <item name="android:textColor">@color/btn_color</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="textAllCaps">false</item>
        <item name="android:textSize">@dimen/sixteen_sp</item>
        <item name="android:paddingTop">@dimen/ten_dp</item>
        <item name="android:paddingBottom">@dimen/ten_dp</item>
        <item name="android:paddingStart">@dimen/forty_dp</item>
        <item name="android:paddingEnd">@dimen/thirty_two_dp</item>
    </style>

    <style name="TextAppearance.RanchID.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>

    <style name="Widget.RanchID.RadioButton" parent="Widget.MaterialComponents.CompoundButton.RadioButton">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.RadioButton</item>
        <item name="buttonTint">@color/button_tint</item>
    </style>

    <style name="ThemeOverlay.App.RadioButton" parent="">
        <item name="colorOnSurface">@color/nait_blue</item>
        <item name="colorSecondary">@color/icon_tint_color</item>
    </style>


    <style name="Widget.RanchID.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.TabLayout</item>
        <item name="tabTextAppearance">@style/TextAppearance.App.Button</item>
    </style>

    <style name="ThemeOverlay.App.TabLayout" parent="">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurface">@color/primary_variant</item>
        <item name="colorOnSurface">@color/icon_tint_color</item>
    </style>

    <style name="TextAppearance.App.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="textAllCaps">false</item>
    </style>


    <!--<style name="Widget.RanchID.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
&lt;!&ndash;        <item name="materialThemeOverlay">@style/ThemeOverlay.App.TextInputLayout</item>&ndash;&gt;
        <item name="hintTextColor">@color/black</item>
    </style>

    <style name="ThemeOverlay.App.TextInputLayout" parent="">
        <item name="colorPrimary">?attr/colorOnPrimary</item>
        <item name="colorOnSurface">@color/nait_blue</item>
        <item name="colorError">@android:color/holo_red_dark</item>
    </style>-->

    <style name="ThemeOverlay.RanchID.DatePicker" parent="@style/ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">@color/btn_color</item>
        <item name="colorOnPrimary">@color/primary_variant</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.App.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.MediumComponent</item>
        <!-- Customize text field of the text input mode. -->
        <item name="textInputStyle">@style/Widget.RanchID.TextInputLayout</item>
    </style>

    <style name="Widget.RanchID.TextInputLayout" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>

    <style name="ShapeAppearance.App.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">cut</item>
    </style>

    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ThemeOverlay.RanchId.TextInputEditText.Outlined" parent="">
        <!--<item name="colorPrimary">@color/black</item>-->
        <item name="colorControlActivated">@color/black</item>
        <!--<item name="colorOnSurface">@color/nait_blue</item>
        <item name="colorError">@android:color/holo_red_dark</item>-->
    </style>


    <style name="ShapeAppearanceOverlay.RanchID.Card.Media" parent="">
        <item name="cornerSizeTopLeft">12dp</item>
        <item name="cornerSizeTopRight">12dp</item>
    </style>

    <!--<style name="ThemeOverlay.RanchID.Button.TextButton.Dialog" parent="">
        <item name="colorPrimary">@color/btn_color</item>
    </style>-->

    <style name="ThemeOverlay.RanchID.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <!--<item name="colorPrimary">@color/shrine_pink_100</item>
        <item name="colorSecondary">@color/shrine_pink_100</item>
        <item name="colorSurface">@color/shrine_pink_light</item>
        <item name="colorOnSurface">@color/shrine_pink_900</item>-->
        <item name="alertDialogStyle">@style/MaterialAlertDialog.RanchID</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.RanchID.Title.Text</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.RanchID.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.RanchID.Button</item>
    </style>

    <style name="MaterialAlertDialog.RanchID" parent="MaterialAlertDialog.MaterialComponents">
        <item name="shapeAppearance">@style/ShapeAppearance.RanchID.MediumComponent</item>
    </style>

    <style name="ShapeAppearance.RanchID.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="Widget.RanchID.Button" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="materialThemeOverlay">@style/ThemeOverlay.RanchID.Button</item>
        <item name="shapeAppearance">@style/ShapeAppearance.RanchID.SmallComponent</item>
    </style>

    <style name="ThemeOverlay.RanchID.Button" parent="">
        <item name="colorPrimary">@color/btn_color</item>
    </style>

    <!--<style name="ShapeAppearance.RanchID.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">cut</item>
        <item name="cornerSize">4dp</item>
    </style>-->

    <style name="MaterialAlertDialog.RanchID.Title.Text" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/btn_color</item>
        <item name="android:textSize">@dimen/eighteen_sp</item>
    </style>

    <style name="ActivityAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="SplashTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!--<item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/colorAccent</item>-->
    </style>

    <style name="ThemeOverlay.Ranch.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/ModalBottomSheetDialog</item>
    </style>

    <style name="ModalBottomSheetDialog" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.App.LargeComponent</item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeTopLeft">16dp</item>
    </style>

    <style name="ThemeOverlay.RanchID.SearchView" parent="">
        <!-- Text color -->
        <item name="android:editTextColor">@color/search_dark</item>
        <!-- Hint text color -->
        <item name="android:textColorHint">@color/search_dark</item>
        <item name="colorControlNormal">@color/search_dark</item>
    </style>

    <style name="MaterialTimePickerStyle" parent="ThemeOverlay.MaterialComponents.TimePicker">
        <item name="colorPrimary">@color/btn_color</item>
        <item name="colorOnPrimary">@color/primary_variant</item>
        <item name="android:textColorPrimary">@color/btn_color</item>

        <item name="materialClockStyle">@style/MaterialTimePickerClockStyle</item>
        <item name="imageButtonStyle">@style/MaterialTimePickerImageButtonStyle</item>
        <item name="materialButtonOutlinedStyle">@style/MaterialTimePickerButtonOutlinedStyle</item>
        <item name="textAppearanceOverline">@style/MaterialTimePickerTextAppearanceOverlineStyle</item>
        <item name="chipStyle">@style/MaterialTimePickerChipStyle</item>
    </style>

    <style name="MaterialTimePickerClockStyle" parent="Widget.MaterialComponents.TimePicker.Clock">
        <item name="clockFaceBackgroundColor">@color/nait_blue</item>
        <item name="clockHandColor">@color/btn_color</item>
        <item name="clockNumberTextColor">@color/time_picker_clock_text</item>
    </style>

    <style name="MaterialTimePickerImageButtonStyle" parent="Widget.MaterialComponents.TimePicker.ImageButton">
        <item name="iconTint">@color/btn_color</item>
        <item name="rippleColor">@color/nait_blue</item>
        <item name="shapeAppearance">@style/MaterialTimePickerImageButtonShapeAppearance</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">?attr/minTouchTargetSize</item>
        <item name="android:minHeight">?attr/minTouchTargetSize</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
    </style>

    <style name="MaterialTimePickerImageButtonShapeAppearance" parent="">
        <item name="cornerSize">50%</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="MaterialTimePickerButtonOutlinedStyle" parent="Widget.MaterialComponents.TimePicker.Button">
        <item name="backgroundTint">@color/time_picker_button_outlined_background</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAppearance">@style/MaterialTimePickerTextAppearanceOverlineStyle</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/btn_color</item>
        <item name="android:textAlignment">center</item>
        <item name="strokeColor">@color/nait_blue</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="MaterialTimePickerTextAppearanceOverlineStyle" parent="TextAppearance.MaterialComponents.TimePicker.Title">
        <item name="android:textColor">@color/btn_color</item>
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textStyle">italic</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.166666667</item>
        <item name="fontFamily">@font/inter_regular</item>
    </style>

    <style name="MaterialTimePickerChipStyle" parent="Widget.MaterialComponents.TimePicker.Display">
        <item name="chipBackgroundColor">@color/time_picker_chip_background</item>
        <item name="rippleColor">@color/time_picker_chip_background</item>
        <item name="android:textColor">@color/time_picker_chip_text</item>
        <item name="android:textAppearance">@style/MaterialTimePickerChipTextAppearance</item>
        <item name="shapeAppearanceOverlay">@style/MaterialTimePickerChipShapeAppearanceStyle</item>
        <item name="materialThemeOverlay">@style/MaterialTimePickerChipMaterialThemeOverlay</item>
    </style>

    <style name="MaterialTimePickerChipTextAppearance" parent="TextAppearance.AppCompat.Body1">
        <item name="fontFamily">sans-serif-light</item>
        <item name="android:textStyle">italic</item>
    </style>

    <style name="MaterialTimePickerChipShapeAppearanceStyle">
        <item name="cornerSize">20%</item>
    </style>

    <style name="MaterialTimePickerChipMaterialThemeOverlay">
        <item name="elevationOverlayEnabled">false</item>
    </style>

</resources>